package who:smart-trust@0.1.0;

/// Pure encoding and decoding: the pipeline steps on their own. No host
/// imports. [STT-GEN-002]
world hcert-codec {
    export types;
    export codec;
    export cose;
}

/// Verifier: what a scanning app or border system embeds.
world hcert-verifier {
    export types;
    export codec;
    export cose;
    export subclaims;
    export dvc;
    export payloads;
    export trust;
    export verifier;
}

/// Issuer: what a clinic or national issuance service embeds.
world hcert-issuer {
    export types;
    export codec;
    export cose;
    export subclaims;
    export dvc;
    export payloads;
    export issuer;
}

/// Everything.
world hcert {
    include hcert-verifier;
    include hcert-issuer;
}
