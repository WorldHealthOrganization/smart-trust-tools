# Direct dependencies of the Python generators and checks. Compile the hashed
# lock with:
#   uv pip compile toolchain/python/requirements.in --generate-hashes \
#     --python-version 3.12 --exclude-newer <a date at least 14 days back> \
#     -o toolchain/python/requirements.txt
# and install only with:
#   pip install --require-hashes --no-deps -r toolchain/python/requirements.txt
pyyaml
rdflib
cbor2
base45
pycddl
pyshacl
