@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix lmx: <https://github.com/litlfred/smart-trust-tools/models/lmx#> .

<https://github.com/litlfred/smart-trust-tools/models/shape/DVCMin>
    a sh:NodeShape ;
    rdfs:label "DVC HCERT Payload" ;
    rdfs:isDefinedBy <http://smart.who.int/trust-phw/StructureDefinition/DVCMin> ;
    sh:targetClass <http://smart.who.int/trust-phw/StructureDefinition/DVCMin> ;
    lmx:abstract true ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMin#n> ; sh:name "n" ; sh:description "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^([\\s\\S]+)$" ; lmx:fhirType "string" ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMin#dob> ; sh:name "dob" ; sh:description "Date of birth" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^(([0-9]([0-9]([0-9][1-9]|[1-9]0)|[1-9]00)|[1-9]000)(-(0[1-9]|1[0-2])(-(0[1-9]|[1-2][0-9]|3[0-1]))?)?)$" ; lmx:fhirType "date" ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMin#s> ; sh:name "s" ; sh:description "Sex" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^([^\\s]+( [^\\s]+)*)$" ; lmx:fhirType "code" ; lmx:bindingStrength "extensible" ; lmx:valueSet <http://hl7.org/fhir/administrative-gender> ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMin#nt> ; sh:name "nt" ; sh:description "Nationality" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^([^\\s]+( [^\\s]+)*)$" ; lmx:fhirType "code" ; lmx:bindingStrength "extensible" ; lmx:valueSet <http://hl7.org/fhir/ValueSet/iso3166-1-3> ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMin#id> ; sh:name "id" ; sh:description "National Identification Document" ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^([\\s\\S]+)$" ; lmx:fhirType "string" ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMin#dt> ; sh:name "dt" ; sh:description "National ID Document Type" ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^([^\\s]+( [^\\s]+)*)$" ; lmx:fhirType "code" ; lmx:bindingStrength "extensible" ; lmx:valueSet <http://terminology.hl7.org/ValueSet/v2-0203> ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMin#gn> ; sh:name "gn" ; sh:description "Parent or Guardian Name" ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^([\\s\\S]+)$" ; lmx:fhirType "string" ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMin#vx> ; sh:name "vx" ; sh:description "Vaccine Details" ; sh:minCount 1 ; sh:maxCount 1 ; sh:node <https://github.com/litlfred/smart-trust-tools/models/shape/DVCMinVaccineDetails> ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMin#v> ; sh:name "v" ; sh:description "Version" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^([\\s\\S]+)$" ; lmx:fhirType "string" ] .

