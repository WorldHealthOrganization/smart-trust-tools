<https://github.com/litlfred/smart-trust-tools/models/shape/DVCMinVaccineDetails>
    a sh:NodeShape ;
    rdfs:label "DVC HCert Vaccine Details (Minimal)" ;
    rdfs:isDefinedBy <http://smart.who.int/trust-phw/StructureDefinition/DVCMinVaccineDetails> ;
    sh:targetClass <http://smart.who.int/trust-phw/StructureDefinition/DVCMinVaccineDetails> ;
    lmx:abstract true ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMinVaccineDetails#vp> ; sh:name "vp" ; sh:description "Vaccine Product ID" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^([^\\s]+( [^\\s]+)*)$" ; lmx:fhirType "code" ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMinVaccineDetails#dv> ; sh:name "dv" ; sh:description "Date of vaccination" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^(([0-9]([0-9]([0-9][1-9]|[1-9]0)|[1-9]00)|[1-9]000)(-(0[1-9]|1[0-2])(-(0[1-9]|[1-2][0-9]|3[0-1]))?)?)$" ; lmx:fhirType "date" ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMinVaccineDetails#cn> ; sh:name "cn" ; sh:description "Name of supervising clinician" ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^([\\s\\S]+)$" ; lmx:fhirType "string" ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMinVaccineDetails#is> ; sh:name "is" ; sh:description "Certificate issuer id (referenced organization)" ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^([A-Za-z0-9\\-\\.]{1,64})$" ; lmx:fhirType "id" ] ;
    sh:property [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMinVaccineDetails#bo> ; sh:name "bo" ; sh:description "Batch No" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^([\\s\\S]+)$" ; lmx:fhirType "string" ] ;
    sh:or ( [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMinVaccineDetails#is> ; sh:minCount 1 ] [ sh:path <http://smart.who.int/trust-phw/StructureDefinition/DVCMinVaccineDetails#cn> ; sh:minCount 1 ] ) ;
    sh:message "must-have-issuer-or-clinician-name: Either issuer or clinicianName must be present" .

