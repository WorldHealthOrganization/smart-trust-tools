    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8610> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/4> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9052> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-4> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-008> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-19> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-20> .

