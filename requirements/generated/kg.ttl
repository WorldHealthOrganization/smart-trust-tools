    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.1> ;
    stt:quote "The registered production trust domains are DDCC, IPS-PILGRIMAGE, PH4H and ICVP." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-006/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-trust-domains> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-006/derivation/3>
    a stt:Derivation ;
