<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-007>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-007" ;
    dcterms:title "HCERT Specification is authoritative" ;
    stt:statement "Where the QR Code Generation walkthrough and the HCERT Specification differ, the library SHALL follow the HCERT Specification. Each release SHALL state which HCERT Specification version and which smart-trust IG version it implements (currently 1.1.1 and 1.7.5)." ;
