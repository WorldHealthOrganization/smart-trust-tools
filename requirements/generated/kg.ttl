<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-005>
    a stt:Requirement ;
    dcterms:identifier "STT-CWT-005" ;
    dcterms:title "iss is an optional alpha-2 string" ;
    stt:statement "iss SHALL be optional and SHALL be encoded as a text string. When present, the issuer SHALL require two upper-case letters, the alpha-2 form used in iss and in the DSC's X.509 C attribute." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-005/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-005/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-07> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-13> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.4> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-005/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.3> ;
    stt:quote "GDHCN participant codes are ISO 3166-1 alpha-3, while the CWT iss claim and the X.509 country attribute take the alpha-2 form" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-006>
    a stt:Requirement ;
    dcterms:identifier "STT-CWT-006" ;
    dcterms:title "Preserve unknown claims" ;
    stt:statement "The decoder SHALL keep CWT claims it does not recognise and expose them to the caller." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8392> ;
