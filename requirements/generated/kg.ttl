<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-010/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-journeys> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-003>
    a stt:Requirement ;
    dcterms:identifier "STT-ISS-003" ;
    dcterms:title "Test keys never in production artifacts" ;
    stt:statement "Fixed test keys and test PKI (such as the XXA SCA and DSC) SHALL only ship in the testkit module. Production modules SHALL NOT contain or accept them by default." ;
    stt:conformance "SHALL NOT" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-003/derivation/2> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-testkit> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.3> ;
    stt:quote "The signing keys are throw-away test keys ... They appear on no trust list" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:quote "It is a documentation aid, not a production issuer: it uses fixed test keys in source" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004>
    a stt:Requirement ;
    dcterms:identifier "STT-ISS-004" ;
    dcterms:title "Two-phase signing" ;
    stt:statement "Issuance SHALL be two-phase: prepare returns the exact bytes to sign (the Sig_structure), the caller signs them by any means, including asynchronous ones such as WebCrypto or a remote KMS, and finish assembles the certificate and returns the HC1 string and the COSE bytes. For ES256, finish SHALL accept r||s or DER and SHALL always emit r||s." ;
    stt:conformance "SHALL" ;
    stt:category "api" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-webcrypto> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-pending-signature> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-issuer> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-15> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-webcrypto> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "Converting between the two is the single most common interoperability bug in HCERT implementations." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001>
    a stt:Requirement ;
    dcterms:identifier "STT-SEC-001" ;
    dcterms:title "No payload content in logs" ;
    stt:statement "The libraries SHALL NOT log payload content, HC1 strings or decoded claims at any default log level. A QR code holds readable personal data." ;
    stt:conformance "SHALL NOT" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:quote "All data is in the QR and is readable by anyone who scans it" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-002>
    a stt:Requirement ;
    dcterms:identifier "STT-SEC-002" ;
    dcterms:title "Vetted crypto backends" ;
    stt:statement "Cryptography SHALL use platform or vetted libraries: JCA/BouncyCastle or Android Keystore for Kotlin JVM/Android, RustCrypto (p256, rsa, sha2) or ring/aws-lc-rs for Rust. Signature verification SHALL be constant-time where the backend allows. The libraries SHALL NOT contain their own implementations of cryptographic primitives." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-002/derivation/1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-001>
    a stt:Requirement ;
    dcterms:identifier "STT-NFR-001" ;
    dcterms:title "Versioning and spec traceability" ;
    stt:statement "Releases SHALL follow semantic versioning. A change to the wire format or to subclaim defaults SHALL be a major or minor version change, as documented in a changelog that cites the smart-trust change (changes.md entry) it implements." ;
    stt:conformance "SHALL" ;
    stt:category "non-functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/changes-1.7.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-9> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-001/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-007> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/changes-1.7.5> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-9> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-002>
    a stt:Requirement ;
    dcterms:identifier "STT-NFR-002" ;
    dcterms:title "Distribution" ;
    stt:statement "The Kotlin library SHALL be published to Maven Central (JVM, Android AAR) and to npm (Kotlin/JS). The Rust library SHALL be published to crates.io, and its jco-transpiled WebAssembly component to npm. All coordinates are still to be chosen." ;
    stt:conformance "SHALL" ;
    stt:category "non-functional" ;
    stt:derivationType "directive" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> ;
