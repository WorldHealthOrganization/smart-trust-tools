    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8392> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-006/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-001>
    a stt:Requirement ;
    dcterms:identifier "STT-CBR-001" ;
    dcterms:title "Deterministic CBOR on encode" ;
    stt:statement "The encoder SHALL produce deterministic CBOR (RFC 8949 section 4.2.1 core deterministic encoding). For the HCERT key sets this matches the RFC 7049 canonical ordering the reference script uses. Same input gives same bytes, in both languages." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-script> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-001/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8949> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-001/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-4> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-cbor> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-002> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-05> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-script> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-001/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8949> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-002>
    a stt:Requirement ;
    dcterms:identifier "STT-CBR-002" ;
    dcterms:title "NFC normalisation" ;
    stt:statement "The encoder SHOULD NFC-normalise text strings. The decoder SHALL accept strings that are not normalised, and comparison helpers SHALL behave as if both sides were normalised to NFC." ;
    stt:conformance "SHOULD" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-002/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-4> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> ;
    stt:quote "Strings SHOULD be NFC-normalised. Decoders SHOULD be permissive about input that is not." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-003>
    a stt:Requirement ;
    dcterms:identifier "STT-CBR-003" ;
    dcterms:title "Bounded CBOR decoding" ;
    stt:statement "The CBOR decoder SHALL enforce configurable limits on nesting depth, item count and string/byte-string length, and SHALL reject malformed or truncated input with a typed error, without panicking or throwing unchecked exceptions." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-003/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-4> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-cbor> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-limits> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:quote "all input fields MUST be properly validated by data types, lengths and contents" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004>
    a stt:Requirement ;
    dcterms:identifier "STT-CBR-004" ;
    dcterms:title "Wire format specified in CDDL" ;
    stt:statement "The CBOR wire format (COSE_Sign1, protected header, CWT claim set, hcert map and payloads) SHALL be specified in CDDL (RFC 8610), and encoders SHALL produce data that validates against it. The envelope SHALL be hand-written from the HCERT Specification; payload rules SHALL be generated from the logical models (STT-PAY-010)." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-open-standards> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8610> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/4> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9052> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-4> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-008> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-19> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-20> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-open-standards> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> ;
    stt:quote "The JSON shown throughout this page and in the logical models is schema notation only — the wire format is CBOR" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/4>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8610> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CBR-004/derivation/5>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9052> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-001>
    a stt:Requirement ;
    dcterms:identifier "STT-COS-001" ;
    dcterms:title "COSE_Sign1 structure" ;
    stt:statement "The issuer SHALL emit 18([protected bstr, unprotected map, payload bstr, signature bstr]). The verifier SHALL accept the tagged form and SHOULD also accept an untagged COSE_Sign1 array." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8152> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-sign1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "The resulting structure is 18([protected, unprotected, payload, signature])." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8152> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-002>
    a stt:Requirement ;
    dcterms:identifier "STT-COS-002" ;
    dcterms:title "Both ES256 and PS256" ;
    stt:statement "The library SHALL implement signing and verification for ES256 (alg -7, ECDSA P-256 with SHA-256) and PS256 (alg -37, RSASSA-PSS with SHA-256, MGF1 SHA-256, salt length 32, modulus at least 2048 bits)." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-002/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8230> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-002/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-alg> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "Both algorithms MUST be implemented, even though only one is used to sign any given certificate" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-002/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8230> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-003>
    a stt:Requirement ;
    dcterms:identifier "STT-COS-003" ;
    dcterms:title "kid placement" ;
    stt:statement "The issuer SHALL put alg and kid in the protected header. The verifier SHALL accept a kid in either the protected or the unprotected header, and SHALL use the protected one when both are present." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-003/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-sign1> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-kid> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "verifiers MUST accept both placements — but when it appears in both, the protected one wins." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004>
    a stt:Requirement ;
    dcterms:identifier "STT-COS-004" ;
    dcterms:title "Sig_structure" ;
    stt:statement """The signature input SHALL be the CBOR encoding of ["Signature1", protected header bytes exactly as transmitted, empty external_aad, payload bytes]. The verifier SHALL use the received protected bytes and SHALL NOT re-encode the decoded header.""" ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8152> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-sign1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "serialise it as CBOR, and sign those bytes." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8152> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-005>
    a stt:Requirement ;
    dcterms:identifier "STT-COS-005" ;
    dcterms:title "Fixed-width r||s ECDSA signatures" ;
    stt:statement "ES256 signatures SHALL be carried as 64-byte r||s. The library SHALL convert from and to the ASN.1 DER form returned or expected by platform crypto APIs (JCA, Android Keystore, PKCS#11, RustCrypto). The verifier SHALL reject an ES256 signature that is not exactly 64 bytes." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-005/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-ecdsa-format> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "For ES256 the COSE signature value is the fixed-width concatenation r || s, 32 bytes each — not the ASN.1 DER encoding" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006>
    a stt:Requirement ;
    dcterms:identifier "STT-COS-006" ;
    dcterms:title "No private keys required in-process" ;
    stt:statement "The issuer SHALL NOT need access to private key material: issuance is prepare, then the caller signs the returned bytes by any means (HSM, KMS, PKCS#11, Android Keystore, WebCrypto), then finish (STT-ISS-004). A software ES256 and PS256 signer SHALL be provided for tests only, in the testkit module." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-pending-signature> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> ;
    stt:quote "Use of HSMs for signing health certificates is highly encouraged." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:quote "a real issuer holds its private keys in an HSM" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001>
    a stt:Requirement ;
    dcterms:identifier "STT-KID-001" ;
    dcterms:title "kid derivation" ;
    stt:statement "kid SHALL be the first 8 bytes of SHA-256 over the DER-encoded DSC. The issuer SHALL derive it from the Signer's DSC, not take it from the caller." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-kid> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "take the DER encoding of the DSC and use the first 8 bytes of its SHA-256 fingerprint" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002>
    a stt:Requirement ;
    dcterms:identifier "STT-KID-002" ;
    dcterms:title "kid is a lookup hint, not unique" ;
    stt:statement "Trust-list lookup by kid SHALL return every matching DSC, and the verifier SHALL try each candidate until one verifies. A kid match alone SHALL NOT count as authentication." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-trust-provider> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "a verifier that finds several DSCs with the same kid MUST try all of them" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-003>
    a stt:Requirement ;
    dcterms:identifier "STT-KID-003" ;
    dcterms:title "kid text forms" ;
    stt:statement "Kid SHALL convert to and from hex, standard base64 and URL-safe base64. Trust-list matching SHALL compare the kid bytes, not their text form." ;
    stt:conformance "SHALL" ;
    stt:category "api" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/did-examples> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-003/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-kid> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-12> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.6> ;
    stt:quote "The kid for both is WHM+BYqqZiE= (hex 58733e058aaa6621)." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/did-examples> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001>
    a stt:Requirement ;
    dcterms:identifier "STT-ZIP-001" ;
    dcterms:title "ZLIB/Deflate after signing" ;
    stt:statement "The issuer SHALL compress the COSE_Sign1 bytes with ZLIB (RFC 1950) using Deflate (RFC 1951) after signing. The verifier SHALL decompress before parsing COSE." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-7> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-6> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-zlib> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-7> ;
    stt:quote "Compression comes after signing, so the verifier decompresses before it verifies." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-002>
    a stt:Requirement ;
    dcterms:identifier "STT-ZIP-002" ;
    dcterms:title "Decompression bomb protection" ;
    stt:statement "Inflation SHALL stop with a typed error once the output exceeds a configurable limit (DecodeLimits.maxInflatedBytes)." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-002/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-6> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-zlib> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-limits> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001>
    a stt:Requirement ;
    dcterms:identifier "STT-B45-001" ;
    dcterms:title "Base45 per RFC 9285" ;
    stt:statement "Base45 encoding and decoding SHALL follow RFC 9285, the published form of the draft the IG cites." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-8> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9285> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-7> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-base45> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-04> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-8> ;
    stt:quote "its 45-character alphabet is exactly the QR Alphanumeric character set" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9285> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002>
    a stt:Requirement ;
    dcterms:identifier "STT-B45-002" ;
    dcterms:title "Strict Base45 decoding" ;
    stt:statement "The decoder SHALL reject characters outside the 45-character alphabet, a dangling single character, and triplets or pairs whose value overflows (above 65535, or above 255 for a trailing pair)." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9285> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-7> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9285> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001>
    a stt:Requirement ;
    dcterms:identifier "STT-HC1-001" ;
    dcterms:title "HC1 prefix" ;
    stt:statement """The issuer SHALL prefix the Base45 string with "HC1:". The verifier SHALL require a context identifier matching HC[1-9A-Z]: and strip it. It SHALL report any identifier other than HC1 as an unsupported version, distinct from malformed input.""" ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-9> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-8> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-hc1> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-9> ;
    stt:quote "A future backwards-incompatible revision will use a new identifier, incrementing through [1-9] and then [A-Z]." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001>
    a stt:Requirement ;
    dcterms:identifier "STT-QR-001" ;
    dcterms:title "QR-ready HC1 output; no QR encoding in the library" ;
    stt:statement """The HC1 string SHALL consist only of characters in the QR Alphanumeric set (the Base45 alphabet and the "HC1:" prefix), so that integrators can encode it as a single Alphanumeric-mode segment with error correction Q using any QR encoder. The libraries SHALL NOT encode or render QR symbols.""" ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-10> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-iso18004> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-9> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-hc1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-10> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> ;
    stt:quote "The Alphanumeric (Mode 2/QR Code symbols 0010) MUST be used in conjunction with Base45." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-iso18004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-005>
    a stt:Requirement ;
    dcterms:identifier "STT-QR-005" ;
    dcterms:title "Camera scanning out of scope" ;
    stt:statement "Decoding QR images from a camera or file is out of scope for the core libraries. The verifier entry point SHALL be the scanned text (HC1 string) or raw COSE bytes." ;
    stt:conformance "SHALL" ;
    stt:category "scope" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-005/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:quote "Confirm the HC1: prefix and strip it." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-001" ;
    dcterms:title "Verification order" ;
    stt:statement "The verifier SHALL run the QR Code Generation section 11 sequence in order: prefix, Base45, inflate, COSE parse, header validation, trust lookup by kid, signature verification, EKU check, CWT decode and time checks, subclaim dispatch, business rules." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-reveive> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-validate-hash> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-1> ;
    stt:quote "A verifier runs the same list upwards." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-002" ;
    dcterms:title "No payload access before the signature is verified" ;
    stt:statement "The API SHALL make the payload and claims reachable only through a successful verification result type. Code that inspects an unverified payload SHALL go through an explicitly named unsafe or diagnostic call." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-result> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:quote "Verify the signature before processing the payload." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:quote "The Issuer Signature SHALL also be verified before any processing of the contents of the HCERT takes place." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-003" ;
    dcterms:title "Defensive protected-header parsing" ;
    stt:statement "Before the signature is checked, the verifier SHALL validate the types and lengths in the protected header: alg is a supported integer, kid is a byte string of the expected length, and no duplicate labels. It SHALL fail closed on anything unexpected." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:quote "Parsing the protected header necessarily happens before signature verification, which makes it an attack surface" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-004" ;
    dcterms:title "EKU check against certificate type" ;
    stt:statement "If the matching DSC has an Extended Key Usage extension with any of 1.3.6.1.4.1.1847.2021.1.1 (test), .1.2 (vaccinations) or .1.3 (recovery), the verifier SHALL check it against the certificate type of the payload: DVC (-6) and DDCC VS (3) are vaccinations, DDCC TR (4) is test, and a DCC (1) is the type of its single v, t or r entry. A DSC with no such extension SHALL be accepted for any type." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-03> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A.2> ;
    stt:quote "If one or more are present, the verifiers SHALL verify the key usage against the stored HCERT." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-005" ;
    dcterms:title "Time checks with an injected clock" ;
    stt:statement "The verifier SHALL reject a certificate whose exp is in the past, and one whose iat is in the future beyond a configurable clock-skew tolerance. The current time SHALL be passed in by the caller (now), never read from an ambient clock." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:quote "Decode the CBOR payload and check exp and iat against the current time." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.5> ;
    stt:quote "after which a Verifier MUST reject the Payload as expired" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.6> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-006>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-006" ;
    dcterms:title "Trust-list presence is the DSC validity check" ;
    stt:statement "The verifier SHALL NOT need CRL or OCSP access. A DSC is valid if it is on the current trust list. The verifier SHOULD also check the DSC's X.509 validity period against the injected clock." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-5.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-006/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-006/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-5.1> ;
    stt:quote "the primary validity mechanism is the presence of the certificate on the most recent version of that certificate list." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-007>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-007" ;
    dcterms:title "Dispatch to logical model, then business rules" ;
    stt:statement "After verification the verifier SHALL decode the hcert entry with the codec registered for its subclaim, falling back to RawPayload. It SHALL then run any registered BusinessRuleHooks and attach their outcomes to the result." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-007/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-display-verified-content> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-execute-business-rule> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-subclaim-registry> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-007/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:quote "Read the hcert claim, dispatch on the subclaim to the right logical model, and only then apply business rules." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-008>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-008" ;
    dcterms:title "Typed verification result and failure taxonomy" ;
    stt:statement "A certificate failing verification SHALL produce a Failed result, not an exception or panic. Failed results SHALL name the step that failed and a reason from a closed set shared by both languages: BadPrefix, UnsupportedContextVersion, Base45Invalid, InflateFailed, LimitExceeded, CoseMalformed, HeaderInvalid, UnsupportedAlgorithm, KidNotFound, SignatureInvalid, KeyUsageMismatch, Expired, NotYetValid, HcertMissing, MultipleSubclaims, PayloadInvalid. Exceptions or errors SHALL be reserved for programming errors and infrastructure failures." ;
    stt:conformance "SHALL" ;
    stt:category "api" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-008/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-008/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-006> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-result> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-008/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-008/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-009>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-009" ;
    dcterms:title "Fully offline verification" ;
    stt:statement "Given a cached or static trust list, verification SHALL need no network access." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-009/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-009/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-static-trust> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-trust-provider> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-009/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:quote "Works fully offline — Yes — verifier needs only the trust list" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-009/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-011>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-011" ;
    dcterms:title "Unverified read for triage" ;
    stt:statement "The verifier SHALL offer an explicitly named unverified read (read-unverified) that decodes an HC1 string up to and including the payload without any trust lookup or signature check, for display and triage where verification is not possible, such as a community health worker offline at a household (journey J2). Its result type SHALL be distinct from a verified result, SHALL carry the kid and the claims it found, and SHALL state that nothing in it is verified. It SHALL apply the same decode limits as verify." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "directive" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-journeys> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-011/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-011/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-unverified> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-011/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-journeys> ;
    stt:quote "lightweight QR scan reads basic vaccine metadata without requiring full cryptographic verification at the household edge" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-011/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001>
    a stt:Requirement ;
    dcterms:identifier "STT-TRU-001" ;
    dcterms:title "Trust store" ;
    stt:statement "Trust material SHALL be held in a trust store that the host fills with DSCs it has obtained, and that returns every trusted DSC matching a kid. The store SHALL do no network or file I/O (STT-GEN-012)." ;
    stt:conformance "SHALL" ;
    stt:category "api" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-retreive-keys> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/RetrievePKIMaterial> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-trust-provider> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> ;
    stt:quote "Ultimately, every Verifier needs to have a list of all public keys it is willing to trust" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002>
    a stt:Requirement ;
    dcterms:identifier "STT-TRU-002" ;
    dcterms:title "GDHCN DID trustlist v2 documents" ;
    stt:statement "The trust store SHALL load GDHCN DID trustlist v2 documents, embedded and reference variants, reading DSCs from verificationMethod publicKeyJwk (x5c) with the kid as the fragment. Fetching the documents, caching them and checking their proofs are the host's." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/did-2.0.0> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/did-structure> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/did-examples> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/endpoints-trustlist> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/4> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-did-core> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/RetrievePKIMaterialDID> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-did-trustlist> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-12> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/did-2.0.0> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/did-structure> ;
    stt:quote """Note that "-" character can be used as a wildcard on each sublevel of root.""" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/did-examples> ;
    stt:quote "Specific keys use base64 encoded key id (kid) as identifier, It is represented as fragments (#) in verification method id" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/4>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/endpoints-trustlist> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/5>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-did-core> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-005>
    a stt:Requirement ;
    dcterms:identifier "STT-TRU-005" ;
    dcterms:title "Static trust lists" ;
    stt:statement "The trust store SHALL load DSCs from PEM and DER, for tests, pinned bilateral or national lists, and fully offline deployments." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-005/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-static-trust> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> ;
    stt:quote "the file format of this trusted list may vary, e.g., it can be a signed JWKS" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001>
    a stt:Requirement ;
    dcterms:identifier "STT-VHL-001" ;
    dcterms:title "VHL payload in the SMART Health Links payload format" ;
    stt:statement "The library SHALL model the VHL payload as the SMART Health Links payload format that IHE VHL reuses: url (required, https), key (required, 43 base64url characters encoding 32 bytes), exp (optional integer, epoch seconds), flag (optional; the letters L and P in alphabetical order), label (optional, at most 80 characters), v (optional integer, default 1) and extension.fhirBaseUrl (optional). Validation SHALL report each violation. The single-file U flag is out of scope and SHALL be reported as unsupported." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-shl> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy3-4.1.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/ext-vhl-payload> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-vhl> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001/derivation/4> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-vhl-payload> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-22> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-23> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-shl> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy3-4.1.3> ;
    stt:quote "Create the VHL payload (using the SHL payload format)" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/ext-vhl-payload> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001/derivation/4>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-vhl> ;
    stt:quote "Single file - ignore" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-002>
    a stt:Requirement ;
    dcterms:identifier "STT-VHL-002" ;
    dcterms:title "VHL payload at HCERT key 5 as a CBOR map" ;
    stt:statement "The issuer SHALL carry the VHL payload at HCERT claim -260 key 5 as a CBOR map with text keys, exp and v as CBOR integers. The verifier SHALL read key 5 as that map, and SHALL also accept a vhlink:/ text string there, so that VHLs built to IHE ITI-YY3 still verify." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "directive" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-vhl> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7.1.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-002/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy3-4.1.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-002/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-ihe-vhl-yy4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-002/derivation/4> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-vhl-payload> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-raw-payload> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-06> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-21> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-vhl> ;
    stt:quote "CBOR map primary" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7.1.5> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-002/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy3-4.1.3> ;
    stt:quote "SHALL contain the VHL payload embedded in HCERT claim structure (claim key -260, key 5)" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-002/derivation/4>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-ihe-vhl-yy4> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-003>
    a stt:Requirement ;
    dcterms:identifier "STT-VHL-003" ;
    dcterms:title "vhlink:/ text form" ;
    stt:statement "The library SHALL convert a VHL payload to and from its text form: the minified JSON, base64url-encoded without padding (RFC 4648), prefixed with vhlink:/." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy3-4.1.3> ;
