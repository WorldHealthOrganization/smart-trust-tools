    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-006/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-cwt> .

