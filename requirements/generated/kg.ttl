    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-002/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8392> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-002/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.5> ;
    stt:quote "SHALL hold a timestamp in the integer NumericDate format" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.6> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-002/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8392> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-003>
    a stt:Requirement ;
    dcterms:identifier "STT-CWT-003" ;
    dcterms:title "Expiry is mandatory on issuance" ;
    stt:statement """The issuer API SHALL require an explicit validity (exp, or a validity period) and SHALL have no default of "never expires". exp is the only revocation mechanism.""" ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-003/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-issuer> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-4> ;
    stt:quote "exp is the only revocation mechanism this specification offers" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-004>
    a stt:Requirement ;
    dcterms:identifier "STT-CWT-004" ;
    dcterms:title "Validity inside the DSC validity" ;
    stt:statement "Before signing, the issuer SHALL check that iat is not before the DSC notBefore and exp is not after the DSC notAfter, and SHALL refuse to sign otherwise." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-004/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-004/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-issuer> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-4> ;
    stt:quote "MUST NOT predate the DSC validity period ... MUST NOT exceed the DSC validity period" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.5> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-004/derivation/3>
    a stt:Derivation ;
