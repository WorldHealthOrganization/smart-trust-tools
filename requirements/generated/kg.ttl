<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-007>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-007" ;
    dcterms:title "HCERT Specification is authoritative" ;
    stt:statement "Where the QR Code Generation walkthrough and the HCERT Specification differ, the library SHALL follow the HCERT Specification. Each release SHALL state which HCERT Specification version and which smart-trust IG version it implements (currently 1.1.1 and 1.7.5)." ;
    stt:conformance "SHALL" ;
    stt:category "non-functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-intro> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-007/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/changes-1.7.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-007/derivation/2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-007/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-intro> ;
    stt:quote "Where this page and the HCERT Specification appear to differ, the HCERT Specification is authoritative." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-007/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/changes-1.7.5> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-008>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-008" ;
    dcterms:title "CBOR is the wire format; JSON is optional" ;
    stt:statement "The library SHALL work entirely on in-memory structures and CBOR. It SHALL NOT need a JSON representation to issue or verify. A JSON view of payloads MAY be provided for display and debugging." ;
    stt:conformance "SHALL" ;
    stt:category "architecture" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-008/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-008/derivation/2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-008/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> ;
    stt:quote "the wire format is CBOR, and an implementation need never produce the JSON form at all." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-008/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-009>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-009" ;
    dcterms:title "Raw transport besides QR" ;
    stt:statement "The issuer SHALL be able to return the signed COSE_Sign1 bytes without the barcode encodings, and the verifier SHALL accept COSE_Sign1 bytes directly, for 8-bit-safe transports (NFC, Bluetooth, app-to-app)." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-009/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-issuer> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-009/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.1> ;
    stt:quote "the HCERT container and its payloads may be transferred as-is, utilising any underlying, 8 bit safe, reliable data transport" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-010>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-010" ;
    dcterms:title "API defined first, in WIT" ;
    stt:statement "The library API SHALL be defined in WIT (api/wit) and reviewed before implementation. The WIT SHALL be the contract both implementations follow: Rust exports it from its WebAssembly component, and Kotlin follows it through documented mapping rules. Each WIT item SHALL cite the requirement(s) it implements. Breaking WIT changes SHALL bump the package version." ;
    stt:conformance "SHALL" ;
    stt:category "architecture" ;
    stt:derivationType "directive" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-010/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-wit> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-010/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-006> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-16> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-010/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-010/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-wit> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-011>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-011" ;
    dcterms:title "Same JavaScript surface from Kotlin/JS and Rust/WASM" ;
    stt:statement "The Node.js packages built from Kotlin/JS and from the Rust WebAssembly component SHALL expose the same TypeScript surface: the declarations jco generates from the WIT (api/generated/ts). The Kotlin/JS declarations SHALL type-check against it." ;
    stt:conformance "SHALL" ;
    stt:category "architecture" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-011/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-jco> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-011/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-006> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-010> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-007> .

