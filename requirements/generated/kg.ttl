<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-001>
    a stt:Requirement ;
    dcterms:identifier "STT-CWT-001" ;
    dcterms:title "Integer claim keys" ;
    stt:statement """The CWT claim set SHALL use the integer keys 1 (iss), 6 (iat), 4 (exp) and -260 (hcert). The hcert map SHALL use integer subclaim keys. The quoted keys in the documentation ("1", "-260", "-6") are JSON notation only and SHALL NOT be emitted as text keys.""" ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-001/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-001/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-001/derivation/4> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-cwt> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-4> ;
    stt:quote "Place the payload under its subclaim, inside the hcert claim, inside a CWT claim set" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> ;
    stt:quote "The JSON shown throughout this page and in the logical models is schema notation only" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-001/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.4> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-001/derivation/4>
    a stt:Derivation ;
