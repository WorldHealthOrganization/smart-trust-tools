<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-010>
    a stt:Requirement ;
    dcterms:identifier "STT-PAY-010" ;
    dcterms:title "Payload models derived from FHIR logical models" ;
    stt:statement "Payload schemas SHALL be derived mechanically from the published FHIR logical models, not written by hand: a JSON-LD 1.1 context that maps the payload's short element names to IRIs, SHACL shapes for cardinality, primitive patterns, invariants and bindings, and CDDL for the CBOR encoding. Inputs SHALL be pinned to a source commit. Typed payload codecs SHALL be checked against these derived schemas." ;
    stt:conformance "SHALL" ;
    stt:category "architecture" ;
    stt:derivationType "directive" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-open-standards> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-010/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvcmin> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-010/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvcmin-vx> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-010/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-json-ld> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-010/derivation/4> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-shacl> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-010/derivation/5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-2> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-008> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-17> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-18> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-19> .

