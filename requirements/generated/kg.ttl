<https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets>
    a stt:Document ;
    dcterms:identifier "dir-targets" ;
    dcterms:title "Stakeholder directive: transpile targets and API-first" ;
    rdfs:comment "Given by the requester on 2026-10-20: Kotlin targets Node, Java (JVM) and Android; Rust targets WebAssembly. The API set is to be defined and reviewed first, in an OpenAPI-like but non-REST definition." .

<https://github.com/litlfred/smart-trust-tools/kg/id/dir-open-standards>
    a stt:Document ;
    dcterms:identifier "dir-open-standards" ;
    dcterms:title "Stakeholder directive: open standards for types and schemas" ;
    rdfs:comment "Given by the requester on 2026-10-20: data types must trace to standardized type systems, with no paywalled ISO standards. Wire format in CDDL; payload models as JSON-LD derived from the FHIR logical models; library API in WIT." .

