<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "Both algorithms MUST be implemented, even though only one is used to sign any given certificate" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-002/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8230> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-003>
    a stt:Requirement ;
    dcterms:identifier "STT-COS-003" ;
    dcterms:title "kid placement" ;
    stt:statement "The issuer SHALL put alg and kid in the protected header. The verifier SHALL accept a kid in either the protected or the unprotected header, and SHALL use the protected one when both are present." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-003/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-sign1> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-kid> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "verifiers MUST accept both placements — but when it appears in both, the protected one wins." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004>
    a stt:Requirement ;
    dcterms:identifier "STT-COS-004" ;
    dcterms:title "Sig_structure" ;
    stt:statement """The signature input SHALL be the CBOR encoding of ["Signature1", protected header bytes exactly as transmitted, empty external_aad, payload bytes]. The verifier SHALL use the received protected bytes and SHALL NOT re-encode the decoded header.""" ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8152> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-sign1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "serialise it as CBOR, and sign those bytes." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8152> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-005>
    a stt:Requirement ;
    dcterms:identifier "STT-COS-005" ;
    dcterms:title "Fixed-width r||s ECDSA signatures" ;
    stt:statement "ES256 signatures SHALL be carried as 64-byte r||s. The library SHALL convert from and to the ASN.1 DER form returned or expected by platform crypto APIs (JCA, Android Keystore, PKCS#11, RustCrypto). The verifier SHALL reject an ES256 signature that is not exactly 64 bytes." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-005/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-ecdsa-format> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "For ES256 the COSE signature value is the fixed-width concatenation r || s, 32 bytes each — not the ASN.1 DER encoding" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006>
    a stt:Requirement ;
    dcterms:identifier "STT-COS-006" ;
    dcterms:title "Signer abstraction, no private keys required in-process" ;
    stt:statement "Signing SHALL go through a Signer interface (algorithm, DSC, sign(bytes)). The issuer SHALL NOT need access to private key material, so HSM, KMS, PKCS#11 and Android Keystore signers can be used. A software signer SHALL be provided for tests only, in the testkit module." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-signer> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> ;
    stt:quote "Use of HSMs for signing health certificates is highly encouraged." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:quote "a real issuer holds its private keys in an HSM" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-007>
    a stt:Requirement ;
    dcterms:identifier "STT-COS-007" ;
    dcterms:title "Optional deterministic ECDSA" ;
    stt:statement "The software ES256 signer in the testkit SHOULD support RFC 6979 deterministic nonces so that issued test artefacts can be reproduced byte for byte. Verifiers SHALL accept any valid ECDSA signature." ;
    stt:conformance "SHOULD" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-007/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc6979> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-007/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-01> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-007/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:quote "regenerates the example above byte for byte" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-007/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc6979> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001>
    a stt:Requirement ;
    dcterms:identifier "STT-KID-001" ;
    dcterms:title "kid derivation" ;
    stt:statement "kid SHALL be the first 8 bytes of SHA-256 over the DER-encoded DSC. The issuer SHALL derive it from the Signer's DSC, not take it from the caller." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-kid> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "take the DER encoding of the DSC and use the first 8 bytes of its SHA-256 fingerprint" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002>
    a stt:Requirement ;
    dcterms:identifier "STT-KID-002" ;
    dcterms:title "kid is a lookup hint, not unique" ;
    stt:statement "Trust-list lookup by kid SHALL return every matching DSC, and the verifier SHALL try each candidate until one verifies. A kid match alone SHALL NOT count as authentication." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-trust-provider> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "a verifier that finds several DSCs with the same kid MUST try all of them" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-003>
    a stt:Requirement ;
    dcterms:identifier "STT-KID-003" ;
    dcterms:title "kid text forms" ;
    stt:statement "Kid SHALL convert to and from hex, standard base64 and URL-safe base64. Trust-list matching SHALL compare the kid bytes, not their text form." ;
    stt:conformance "SHALL" ;
    stt:category "api" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/did-examples> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-003/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-kid> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-12> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.6> ;
    stt:quote "The kid for both is WHM+BYqqZiE= (hex 58733e058aaa6621)." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/did-examples> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001>
    a stt:Requirement ;
    dcterms:identifier "STT-ZIP-001" ;
    dcterms:title "ZLIB/Deflate after signing" ;
    stt:statement "The issuer SHALL compress the COSE_Sign1 bytes with ZLIB (RFC 1950) using Deflate (RFC 1951) after signing. The verifier SHALL decompress before parsing COSE." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-7> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-6> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-zlib> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-7> ;
    stt:quote "Compression comes after signing, so the verifier decompresses before it verifies." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-002>
    a stt:Requirement ;
    dcterms:identifier "STT-ZIP-002" ;
    dcterms:title "Decompression bomb protection" ;
    stt:statement "Inflation SHALL stop with a typed error once the output exceeds a configurable limit (DecodeLimits.maxInflatedBytes)." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-002/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-6> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-zlib> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-limits> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001>
    a stt:Requirement ;
    dcterms:identifier "STT-B45-001" ;
    dcterms:title "Base45 per RFC 9285" ;
    stt:statement "Base45 encoding and decoding SHALL follow RFC 9285, the published form of the draft the IG cites." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-8> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9285> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-7> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-base45> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-04> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-8> ;
    stt:quote "its 45-character alphabet is exactly the QR Alphanumeric character set" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9285> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002>
    a stt:Requirement ;
    dcterms:identifier "STT-B45-002" ;
    dcterms:title "Strict Base45 decoding" ;
    stt:statement "The decoder SHALL reject characters outside the 45-character alphabet, a dangling single character, and triplets or pairs whose value overflows (above 65535, or above 255 for a trailing pair)." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9285> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-7> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-001> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9285> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001>
    a stt:Requirement ;
    dcterms:identifier "STT-HC1-001" ;
    dcterms:title "HC1 prefix" ;
    stt:statement """The issuer SHALL prefix the Base45 string with "HC1:". The verifier SHALL require a context identifier matching HC[1-9A-Z]: and strip it. It SHALL report any identifier other than HC1 as an unsupported version, distinct from malformed input.""" ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-9> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-8> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-hc1> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-9> ;
    stt:quote "A future backwards-incompatible revision will use a new identifier, incrementing through [1-9] and then [A-Z]." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001>
    a stt:Requirement ;
    dcterms:identifier "STT-QR-001" ;
    dcterms:title "ISO/IEC 18004 QR in Alphanumeric mode" ;
    stt:statement "The QR encoder SHALL produce an ISO/IEC 18004:2015 symbol carrying the whole HC1 string as Alphanumeric-mode (0010) data. It SHALL NOT fall back to byte mode, and SHALL fail if the input has characters outside the alphanumeric set." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-10> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-iso18004> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-9> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-qr> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-10> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> ;
    stt:quote "The Alphanumeric (Mode 2/QR Code symbols 0010) MUST be used in conjunction with Base45." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-iso18004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-002>
    a stt:Requirement ;
    dcterms:identifier "STT-QR-002" ;
    dcterms:title "Error correction Q by default" ;
    stt:statement "Error-correction level SHALL default to Q and SHALL be configurable. Symbol version SHALL be the smallest that fits unless the caller pins one." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-10> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-002/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-9> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-qr> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-10> ;
    stt:quote "Level Q, approximately 25% — RECOMMENDED" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-003>
    a stt:Requirement ;
    dcterms:identifier "STT-QR-003" ;
    dcterms:title "Rendering is optional and kept separate" ;
    stt:statement "The core QR output SHALL be a module matrix with no imaging dependency. PNG and SVG rendering SHALL be optional: separate artifacts in Kotlin, cargo features in Rust." ;
    stt:conformance "SHALL" ;
    stt:category "architecture" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-10> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-003/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-9> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-qr> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-qr-render> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-10> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-004>
    a stt:Requirement ;
    dcterms:identifier "STT-QR-004" ;
    dcterms:title "Print-safe rendering" ;
    stt:statement "Renderers SHALL scale modules by whole numbers of device pixels so that every module is square, SHALL emit a quiet zone of at least 4 modules, and SHOULD provide a helper that picks the scale for a target diagonal of 35 to 60 mm at a given dpi." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-10> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-004/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-9> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-003> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-qr-render> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-10> ;
    stt:quote "make sure each module is rendered as an exact square. Non-proportional scaling turns modules into rectangles" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-005>
    a stt:Requirement ;
    dcterms:identifier "STT-QR-005" ;
    dcterms:title "Camera scanning out of scope" ;
    stt:statement "Decoding QR images from a camera or file is out of scope for the core libraries. The verifier entry point SHALL be the scanned text (HC1 string) or raw COSE bytes." ;
    stt:conformance "SHALL" ;
    stt:category "scope" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-005/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:quote "Confirm the HC1: prefix and strip it." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-006>
    a stt:Requirement ;
    dcterms:identifier "STT-QR-006" ;
    dcterms:title "Encoding report" ;
    stt:statement "The issuer SHALL return an EncodingReport with the size at every stage (CBOR, COSE, deflated, HC1 characters) and the QR version and error-correction level. It SHALL add a warning when the HC1 length is over a configurable threshold, pointing to VHL as the alternative." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-006/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-006/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-4> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-6> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-7> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-9> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-report> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-006/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.5> ;
    stt:quote "a payload that grows much beyond this belongs behind a VHL instead" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-006/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-001" ;
    dcterms:title "Verification order" ;
    stt:statement "The verifier SHALL run the QR Code Generation section 11 sequence in order: prefix, Base45, inflate, COSE parse, header validation, trust lookup by kid, signature verification, EKU check, CWT decode and time checks, subclaim dispatch, business rules." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-reveive> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-validate-hash> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-1> ;
    stt:quote "A verifier runs the same list upwards." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-002" ;
    dcterms:title "No payload access before the signature is verified" ;
    stt:statement "The API SHALL make the payload and claims reachable only through a successful verification result type. Code that inspects an unverified payload SHALL go through an explicitly named unsafe or diagnostic call." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-result> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:quote "Verify the signature before processing the payload." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:quote "The Issuer Signature SHALL also be verified before any processing of the contents of the HCERT takes place." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-003" ;
    dcterms:title "Defensive protected-header parsing" ;
    stt:statement "Before the signature is checked, the verifier SHALL validate the types and lengths in the protected header: alg is a supported integer, kid is a byte string of the expected length, and no duplicate labels. It SHALL fail closed on anything unexpected." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:quote "Parsing the protected header necessarily happens before signature verification, which makes it an attack surface" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-004" ;
    dcterms:title "EKU check against certificate type" ;
    stt:statement "If the matching DSC has an Extended Key Usage extension with any of 1.3.6.1.4.1.1847.2021.1.1 (test), .1.2 (vaccinations) or .1.3 (recovery), the verifier SHALL check it against the certificate type of the payload, using a pluggable CertificateTypeResolver. A DSC with no such extension SHALL be accepted for any type. The default resolver SHALL map DVC (-6) and DDCC VS (3) to vaccinations and DDCC TR (4) to test." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-cert-type> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-03> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A.2> ;
    stt:quote "If one or more are present, the verifiers SHALL verify the key usage against the stored HCERT." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-005" ;
    dcterms:title "Time checks with an injected clock" ;
    stt:statement "The verifier SHALL reject a certificate whose exp is in the past. It SHALL flag an iat in the future, beyond a configurable clock-skew tolerance. Time SHALL come from an injected Clock. Extra iat-based policies (for example a maximum age) MAY be configured." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-clock> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:quote "Decode the CBOR payload and check exp and iat against the current time." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.5> ;
    stt:quote "after which a Verifier MUST reject the Payload as expired" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.6> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-006>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-006" ;
    dcterms:title "Trust-list presence is the DSC validity check" ;
    stt:statement "The verifier SHALL NOT need CRL or OCSP access. A DSC is valid if it is on the current trust list. The verifier SHOULD also check the DSC's X.509 validity period against the injected clock." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-5.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-006/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-006/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-5.1> ;
    stt:quote "the primary validity mechanism is the presence of the certificate on the most recent version of that certificate list." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-007>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-007" ;
    dcterms:title "Dispatch to logical model, then business rules" ;
    stt:statement "After verification the verifier SHALL decode the hcert entry with the codec registered for its subclaim, falling back to RawPayload. It SHALL then run any registered BusinessRuleHooks and attach their outcomes to the result." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-007/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-display-verified-content> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-execute-business-rule> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-business-rules> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-subclaim-registry> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-007/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:quote "Read the hcert claim, dispatch on the subclaim to the right logical model, and only then apply business rules." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-008>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-008" ;
    dcterms:title "Typed verification result and failure taxonomy" ;
    stt:statement "A certificate failing verification SHALL produce a Failed result, not an exception or panic. Failed results SHALL name the step that failed and a reason from a closed set shared by both languages: BadPrefix, UnsupportedContextVersion, Base45Invalid, InflateFailed, LimitExceeded, CoseMalformed, HeaderInvalid, UnsupportedAlgorithm, KidNotFound, SignatureInvalid, KeyUsageMismatch, Expired, NotYetValid, HcertMissing, MultipleSubclaims, PayloadInvalid. Exceptions or errors SHALL be reserved for programming errors and infrastructure failures." ;
    stt:conformance "SHALL" ;
    stt:category "api" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-008/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-008/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-006> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-result> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-008/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-008/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-009>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-009" ;
    dcterms:title "Fully offline verification" ;
    stt:statement "Given a cached or static trust list, verification SHALL need no network access." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-009/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-009/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-static-trust> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-trust-provider> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-009/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:quote "Works fully offline — Yes — verifier needs only the trust list" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-009/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-010>
    a stt:Requirement ;
    dcterms:identifier "STT-VER-010" ;
    dcterms:title "Narrow lookup by iss" ;
    stt:statement "When iss is present, the verifier MAY use it to narrow trust-list lookup to that issuer's DSCs. A mismatch between iss and the DSC country SHALL be reported as a diagnostic." ;
    stt:conformance "MAY" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-010/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-13> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-010/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.4> ;
    stt:quote "This claim can be used by a Verifier to identify which set of DSCs to use for validation." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001>
    a stt:Requirement ;
    dcterms:identifier "STT-TRU-001" ;
    dcterms:title "TrustListProvider abstraction" ;
    stt:statement "Trust material SHALL be reached through a TrustListProvider that returns every trusted DSC matching a query of kid plus optional issuer, trust domain, participant and key usage." ;
    stt:conformance "SHALL" ;
    stt:category "api" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-retreive-keys> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/RetrievePKIMaterial> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-trust-provider> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> ;
    stt:quote "Ultimately, every Verifier needs to have a list of all public keys it is willing to trust" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002>
    a stt:Requirement ;
    dcterms:identifier "STT-TRU-002" ;
    dcterms:title "GDHCN DID trustlist v2 client" ;
    stt:statement """The library SHALL provide a TrustListProvider for the GDHCN DID trustlist v2. It SHALL support the embedded and reference variants, the DEV, UAT and PROD environments, and the hierarchical root/$domain/$participant/$usage paths with "-" as a wildcard. It SHALL read DSCs from verificationMethod publicKeyJwk (x5c), with the kid as the fragment.""" ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/did-2.0.0> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/did-structure> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/did-examples> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/endpoints-trustlist> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/4> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-did-core> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/RetrievePKIMaterialDID> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-did-trustlist> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-12> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/did-2.0.0> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/did-structure> ;
    stt:quote """Note that "-" character can be used as a wildcard on each sublevel of root.""" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/did-examples> ;
    stt:quote "Specific keys use base64 encoded key id (kid) as identifier, It is represented as fragments (#) in verification method id" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/4>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/endpoints-trustlist> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002/derivation/5>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-did-core> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-003>
    a stt:Requirement ;
    dcterms:identifier "STT-TRU-003" ;
    dcterms:title "Check trust-list integrity" ;
    stt:statement "The DID trustlist client SHOULD verify the JWS proof on fetched DID documents against a configured GDHCN anchor, and SHALL use HTTPS with platform certificate validation." ;
    stt:conformance "SHOULD" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/did-examples> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-003/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-002> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/did-examples> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-004>
    a stt:Requirement ;
    dcterms:identifier "STT-TRU-004" ;
    dcterms:title "Cache and refresh" ;
    stt:statement "Trust-list providers that fetch remotely SHALL cache the last good list persistently, SHALL refresh it on a configurable schedule, and SHALL expose when it was last updated so that callers can apply a staleness policy. A failed refresh SHALL keep the last good list." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-004/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-trust-provider> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-did-trustlist> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> ;
    stt:quote "Verifiers MUST fetch and update this list regularly." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-005>
    a stt:Requirement ;
    dcterms:identifier "STT-TRU-005" ;
    dcterms:title "Static and national trust lists" ;
    stt:statement "The library SHALL provide a static TrustListProvider loaded from PEM, DER or JWKS, for tests, pinned bilateral or national lists, and fully offline deployments." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-005/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc7517> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-005/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-static-trust> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> ;
    stt:quote "the file format of this trusted list may vary, e.g., it can be a signed JWKS" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-005/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc7517> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-006>
    a stt:Requirement ;
    dcterms:identifier "STT-TRU-006" ;
    dcterms:title "Optional DSC-to-SCA chain check" ;
    stt:statement "When SCA certificates are available, the library SHOULD check that each DSC is signed by a listed SCA, that the DSC AKI matches the SCA SKI, and that the SCA C attribute matches the issuing country." ;
    stt:conformance "SHOULD" ;
    stt:category "security" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-006/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc5280> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-006/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-006/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-5> ;
    stt:quote "MUST be signed with the private key corresponding to a SCA certificate published on the aforementioned list" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-006/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc5280> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-001>
    a stt:Requirement ;
    dcterms:identifier "STT-ISS-001" ;
    dcterms:title "One-call issuance" ;
    stt:statement "HcertIssuer SHALL take a payload, its codec, a validity and a Signer, and return the HC1 string. On request it SHALL also return the raw COSE bytes, the QR matrix and the EncodingReport." ;
    stt:conformance "SHALL" ;
    stt:category "api" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-001/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-4> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-6> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-7> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-8> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-9> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/IssuerVDHC-generate> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/IssuerVDHC-sign> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-issuer> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-002>
    a stt:Requirement ;
    dcterms:identifier "STT-ISS-002" ;
    dcterms:title "Optional self-verification after issuance" ;
    stt:statement "The issuer SHALL offer a policy flag that decodes and verifies every certificate it has just issued against the Signer's DSC before returning it. The flag SHOULD default to on in the testkit." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-002/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-issuer> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:quote "then decodes its own output and verifies the signature, so a failed run is a failed round trip rather than a silently broken certificate" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-003>
    a stt:Requirement ;
    dcterms:identifier "STT-ISS-003" ;
    dcterms:title "Test keys never in production artifacts" ;
    stt:statement "Fixed test keys and test PKI (such as the XXA SCA and DSC) SHALL only ship in the testkit module. Production modules SHALL NOT contain or accept them by default." ;
    stt:conformance "SHALL NOT" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-003/derivation/2> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-testkit> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.3> ;
    stt:quote "The signing keys are throw-away test keys ... They appear on no trust list" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:quote "It is a documentation aid, not a production issuer: it uses fixed test keys in source" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004>
    a stt:Requirement ;
    dcterms:identifier "STT-ISS-004" ;
    dcterms:title "Two-phase signing" ;
    stt:statement "The issuer SHALL offer a two-phase flow: prepare returns the exact bytes to sign (the Sig_structure), the caller signs them by any means, including asynchronous ones such as WebCrypto or a remote KMS, and finish assembles the certificate. For ES256, finish SHALL accept r||s or DER and SHALL always emit r||s." ;
    stt:conformance "SHALL" ;
    stt:category "api" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-webcrypto> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-pending-signature> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-issuer> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-15> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-webcrypto> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-ISS-004/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> ;
    stt:quote "Converting between the two is the single most common interoperability bug in HCERT implementations." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001>
    a stt:Requirement ;
    dcterms:identifier "STT-SEC-001" ;
    dcterms:title "No payload content in logs" ;
    stt:statement "The libraries SHALL NOT log payload content, HC1 strings or decoded claims at any default log level. A QR code holds readable personal data." ;
    stt:conformance "SHALL NOT" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:quote "All data is in the QR and is readable by anyone who scans it" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-002>
    a stt:Requirement ;
    dcterms:identifier "STT-SEC-002" ;
    dcterms:title "Vetted crypto backends" ;
    stt:statement "Cryptography SHALL use platform or vetted libraries: JCA/BouncyCastle or Android Keystore for Kotlin JVM/Android, RustCrypto (p256, rsa, sha2) or ring/aws-lc-rs for Rust. Signature verification SHALL be constant-time where the backend allows. The libraries SHALL NOT contain their own implementations of cryptographic primitives." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-002/derivation/1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-001>
    a stt:Requirement ;
    dcterms:identifier "STT-NFR-001" ;
    dcterms:title "Versioning and spec traceability" ;
    stt:statement "Releases SHALL follow semantic versioning. A change to the wire format or to subclaim defaults SHALL be a major or minor version change, as documented in a changelog that cites the smart-trust change (changes.md entry) it implements." ;
    stt:conformance "SHALL" ;
    stt:category "non-functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/changes-1.7.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-9> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-001/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-007> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/changes-1.7.5> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-9> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-002>
    a stt:Requirement ;
    dcterms:identifier "STT-NFR-002" ;
    dcterms:title "Distribution" ;
    stt:statement "The Kotlin library SHALL be published to Maven Central (JVM, Android AAR) and to npm (Kotlin/JS). The Rust library SHALL be published to crates.io, and its jco-transpiled WebAssembly component to npm. All coordinates are still to be chosen." ;
    stt:conformance "SHALL" ;
    stt:category "non-functional" ;
    stt:derivationType "directive" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-002/derivation/2> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-14> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-001" ;
    dcterms:title "PR 129 example as a conformance vector" ;
    stt:statement "Both libraries SHALL verify the two HC1 strings in dvc-qr-example-XXA.json against dvc-qr-example-XXA-dsc.pem, with the clock fixed inside 2026-09-29T08:30Z to 2027-09-29T08:30Z. Each SHALL give kid WHM+BYqqZiE=, subclaim -6, and payloads equal to those in the JSON. The committed files SHALL be used as-is; they SHALL NOT be regenerated." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-pem> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/3> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-testkit> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-01> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.6> ;
    stt:quote "so that a verifier implementation can be exercised against this example end to end" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-pem> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-002>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-002" ;
    dcterms:title "Byte-exact CBOR vector" ;
    stt:statement "Encoding the PR 129 example claim sets with deterministic CBOR SHALL give exactly the payload bytes inside the committed COSE_Sign1: 210 bytes for hepb1 and 209 for bcg. Signed, deflated and HC1 sizes SHALL NOT be asserted exactly, because signatures are randomized." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-002/derivation/2> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-01> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-05> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.5> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-003" ;
    dcterms:title "Cross-implementation interoperability" ;
    stt:statement "Certificates issued by each library (ES256 and PS256) SHALL verify in the other library and in the smart-trust reference script's verify routine. Certificates issued by the reference script SHALL verify in both libraries." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-006> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-004" ;
    dcterms:title "Negative vectors" ;
    stt:statement "The shared vector set SHALL include failing cases with the expected failure reason for each: tampered payload, tampered protected header, wrong or unknown kid, duplicate kid with only the second DSC valid, a DER-encoded ES256 signature, expired, iat before the DSC validity, EKU mismatch, missing or unsupported prefix (HC2:), invalid Base45, decompression bomb, deeply nested CBOR, multiple subclaims, and a DVC without is or cn." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004/derivation/2> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-testkit> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-005>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-005" ;
    dcterms:title "Language-neutral vector format" ;
    stt:statement "Conformance vectors SHALL be stored once, in a language-neutral format (JSON plus PEM), in this repository, and loaded by both test suites." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-005/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-005/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-006> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-testkit> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-005/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-006" ;
    dcterms:title "Fuzzing of decoders" ;
    stt:statement "The Base45, ZLIB, CBOR, COSE and full verifier entry points SHALL be fuzzed in CI (cargo-fuzz for Rust, Jazzer or kotlinx-fuzz for Kotlin). No input may crash them, hang them, or exceed DecodeLimits." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006/derivation/1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:quote "a potential attacker may attempt to inject carefully crafted information designed to compromise the security of the system" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-007>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-007" ;
    dcterms:title "One TypeScript conformance suite for both Node packages" ;
    stt:statement "A single TypeScript test suite, type-checked against api/generated/ts and driven by the shared vectors, SHALL run in CI against both the Kotlin/JS npm package and the jco-transpiled Rust component, and SHALL pass on both." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-007/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-007/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-011> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-testkit> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-007/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-007/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-008>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-008" ;
    dcterms:title "Schema checks against the vectors" ;
    stt:statement "CI SHALL validate every conformance vector against the CDDL (COSE_Sign1, protected header, CWT claims) and its payload against the SHACL shapes through the JSON-LD context. It SHALL also check that mutated payloads (invariant broken, bad FHIR date, missing required element, bad FHIR id) are rejected and that valid variants (cn only, partial date) are accepted, by both CDDL and SHACL." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-008/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8610> ;
