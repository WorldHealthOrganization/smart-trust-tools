<https://github.com/litlfred/smart-trust-tools/kg/vocab#Requirement>
    a rdfs:Class ;
    rdfs:label "Library requirement" ;
    rdfs:comment "A derived requirement on the Kotlin/Rust HCERT libraries." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#Derivation>
    a rdfs:Class ;
    rdfs:label "Derivation" ;
    rdfs:comment "Reified derivation link from a requirement to a source, with optional quote." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#Document>
    a rdfs:Class ;
    rdfs:label "Source document" ;
    rdfs:comment "A source page, file, standard or stakeholder directive." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#Section>
    a rdfs:Class ;
    rdfs:label "Source section" ;
    rdfs:comment "A headed section of a source document." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#UpstreamRequirement>
    a rdfs:Class ;
    rdfs:label "Upstream requirement" ;
    rdfs:comment "A FHIR Requirements resource in the smart-trust IG." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#UpstreamStatement>
    a rdfs:Class ;
    rdfs:label "Upstream requirement statement" ;
    rdfs:comment "A statement inside a smart-trust FHIR Requirements resource." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#Actor>
    a rdfs:Class ;
    rdfs:label "Actor" ;
    rdfs:comment "A smart-trust ActorDefinition." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#PipelineStep>
    a rdfs:Class ;
    rdfs:label "Pipeline step" ;
    rdfs:comment "A step of the HCERT QR pipeline." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#ApiModule>
    a rdfs:Class ;
    rdfs:label "API module" ;
    rdfs:comment "A library module." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#ApiElement>
    a rdfs:Class ;
    rdfs:label "API element" ;
    rdfs:comment "A type, interface, function or enum of the library API." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#OpenIssue>
    a rdfs:Class ;
    rdfs:label "Open issue" ;
    rdfs:comment "A gap, ambiguity or inconsistency found in the sources." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#statement>
    a rdf:Property ;
    rdfs:label "statement" ;
    rdfs:comment "Normative requirement text." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#conformance>
    a rdf:Property ;
    rdfs:label "conformance" ;
    rdfs:comment "BCP 14 conformance verb." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#category>
    a rdf:Property ;
    rdfs:label "category" .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#derivationType>
    a rdf:Property ;
    rdfs:label "derivation type" ;
    rdfs:comment "direct, derived or directive." .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#target>
    a rdf:Property ;
    rdfs:label "target language" .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#rationale>
    a rdf:Property ;
    rdfs:label "rationale" .

<https://github.com/litlfred/smart-trust-tools/kg/vocab#quote>
