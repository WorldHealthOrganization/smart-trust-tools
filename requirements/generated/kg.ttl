<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-NFR-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-001" ;
    dcterms:title "PR 129 example as a conformance vector" ;
    stt:statement "Both libraries SHALL verify the two HC1 strings in dvc-qr-example-XXA.json against dvc-qr-example-XXA-dsc.pem, with the clock fixed inside 2026-09-29T08:30Z to 2027-09-29T08:30Z. Each SHALL give kid WHM+BYqqZiE=, subclaim -6, and payloads equal to those in the JSON. The committed files SHALL be used as-is; they SHALL NOT be regenerated." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-pem> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/3> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-testkit> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-01> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.6> ;
    stt:quote "so that a verifier implementation can be exercised against this example end to end" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-pem> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-002>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-002" ;
    dcterms:title "Byte-exact CBOR vector" ;
    stt:statement "Encoding the PR 129 example claim sets with deterministic CBOR SHALL give exactly the payload bytes inside the committed COSE_Sign1: 210 bytes for hepb1 and 209 for bcg. Signed, deflated and HC1 sizes SHALL NOT be asserted exactly, because signatures are randomized." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-002/derivation/2> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-01> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-05> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.5> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-003" ;
    dcterms:title "Cross-implementation interoperability" ;
    stt:statement "Certificates issued by each library (ES256 and PS256) SHALL verify in the other library and in the smart-trust reference script's verify routine. Certificates issued by the reference script SHALL verify in both libraries." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-006> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-13> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-004" ;
    dcterms:title "Negative vectors" ;
    stt:statement "The shared vector set SHALL include failing cases with the expected failure reason for each: tampered payload, tampered protected header, wrong or unknown kid, duplicate kid with only the second DSC valid, a DER-encoded ES256 signature, expired, iat before the DSC validity, EKU mismatch, missing or unsupported prefix (HC2:), invalid Base45, decompression bomb, deeply nested CBOR, multiple subclaims, and a DVC without is or cn." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004/derivation/2> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-testkit> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-005>
    a stt:Requirement ;
    dcterms:identifier "STT-TST-005" ;
    dcterms:title "Language-neutral vector format" ;
    stt:statement "Conformance vectors SHALL be stored once, in a language-neutral format (JSON plus PEM), in this repository, and loaded by both test suites." ;
    stt:conformance "SHALL" ;
    stt:category "test" ;
