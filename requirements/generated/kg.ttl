<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-001>
    a stt:Requirement ;
    dcterms:identifier "STT-SEL-001" ;
    dcterms:title "Built-in subclaim registry" ;
    stt:statement "The library SHALL ship a subclaim registry containing 1 (HCertDCC), 3 (DDCCCoreDataSetVS), 4 (DDCCCoreDataSetTR), 5 (VHL URI), -6 (DVCMin) and -7 (MedicationTreatmentLineMin), each with its status (Assigned, Proposed, Development range) and logical-model canonical URL." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-001/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-sd-hcert> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-001/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-1> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-subclaim> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-subclaim-registry> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-06> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-08> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.1> ;
    stt:quote "These are the subclaims enumerated by the HCert logical model." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7.1> ;
    stt:quote "While the logical model enlists assigned sub claims, the ones listed in this specification are considered authoritative" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-001/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-sd-hcert> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-002>
    a stt:Requirement ;
    dcterms:identifier "STT-SEL-002" ;
    dcterms:title "Registry is extensible" ;
    stt:statement "Integrators SHALL be able to register more subclaims and their codecs, and override the defaults, at runtime, without forking the library." ;
    stt:conformance "SHALL" ;
    stt:category "api" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-002/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-1> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-subclaim-registry> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7.1> ;
    stt:quote "subclaims for negative integer values are for development purposes and are free to use" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-003>
    a stt:Requirement ;
    dcterms:identifier "STT-SEL-003" ;
    dcterms:title "Development-range subclaims need explicit opt-in" ;
    stt:statement "The registry SHALL classify subclaims >= 0 as WHO-reserved and negative subclaims as development range. The issuer SHALL refuse to issue a development-range subclaim unless the issuer policy explicitly allows it. The subclaim number used for a payload type SHALL be configuration, not a constant in a codec, so that DVC can move from -6 to an assigned number without an API break." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-003/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-1> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-subclaim-registry> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-issuer> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-09> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.1> ;
    stt:quote "Do not treat a negative subclaim as a production allocation." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004>
    a stt:Requirement ;
    dcterms:identifier "STT-SEL-004" ;
    dcterms:title "Exactly one payload when issuing" ;
    stt:statement "The issuer SHALL emit an hcert (-260) map with exactly one entry. The verifier SHALL expose every entry present. When there is more than one entry, the verifier SHALL report it as a diagnostic, and SHALL fail verification if the policy is strict, which SHALL be the default." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-hcert-claim> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-02> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2> ;
    stt:quote "An HCERT carries exactly one payload, identified by a subclaim inside the hcert claim" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-4> ;
    stt:quote "Map whose single key is the subclaim chosen in Step 1" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7> ;
    stt:quote "Several different types of health certificate MAY exist under the same claim" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-005>
    a stt:Requirement ;
    dcterms:identifier "STT-SEL-005" ;
    dcterms:title "Payload type advisor" ;
    stt:statement """The library MAY provide an advisor that implements the decision summary: ICVP for IHR entry requirements; DVC (-6) when the content must verify offline and fits in a QR code; VHL (5) otherwise. It SHOULD report an estimated HC1 length so that "fits in a QR" is decided on numbers.""" ;
    stt:conformance "MAY" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-005/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-005/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-005/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-1> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-advisor> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-005/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-005/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.4> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-006>
    a stt:Requirement ;
    dcterms:identifier "STT-SEL-006" ;
    dcterms:title "Trust domain codes come from the value set" ;
    stt:statement "Trust domain codes (currently DDCC, IPS-PILGRIMAGE, PH4H, ICVP) SHALL be treated as data loaded from, or checked against, the GDHCN Trust Domain value set. They SHALL NOT be a closed enum." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-006/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-trust-domains> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-006/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-vs-domains> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-006/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-trust> .

