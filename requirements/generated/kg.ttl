    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-005>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-005" ;
    dcterms:title "Rust second, for WebAssembly" ;
    stt:statement "The second implementation SHALL be a Rust library meeting this same requirement set. It SHALL build for wasm32 as a WebAssembly component implementing the WIT worlds in api/wit, and SHALL be transpiled with jco into an npm package usable from Node.js and browsers. A native crate SHALL also be published. The codec module SHOULD build without std (with alloc)." ;
    stt:conformance "SHALL" ;
    stt:category "non-functional" ;
    stt:derivationType "directive" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-005/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> ;
