    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-005/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-jco> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-005/derivation/4> .

