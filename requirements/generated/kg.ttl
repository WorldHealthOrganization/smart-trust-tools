<https://github.com/litlfred/smart-trust-tools/kg/id/step-1>
    a stt:PipelineStep ;
    dcterms:title "Select payload type" ;
    stt:order 1 ;
    stt:output "hcert subclaim + logical model" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-2>
    a stt:PipelineStep ;
    dcterms:title "Assemble payload" ;
    stt:order 2 ;
    stt:output "logical-model instance" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-3>
    a stt:PipelineStep ;
    dcterms:title "Wrap in CWT claim set" ;
    stt:order 3 ;
    stt:output "{1: iss, 6: iat, 4: exp, -260: {subclaim: payload}}" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-4> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-4>
    a stt:PipelineStep ;
    dcterms:title "Serialise as CBOR" ;
    stt:order 4 ;
    stt:output "bytes" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-5>
    a stt:PipelineStep ;
    dcterms:title "Sign as COSE_Sign1" ;
    stt:order 5 ;
    stt:output "bytes, CBOR tag 18" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-6>
    a stt:PipelineStep ;
    dcterms:title "Compress with ZLIB/Deflate" ;
    stt:order 6 ;
    stt:output "bytes" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-7> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-7>
    a stt:PipelineStep ;
    dcterms:title "Encode as Base45" ;
    stt:order 7 ;
    stt:output "ASCII" ;
