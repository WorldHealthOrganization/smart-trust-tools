<https://github.com/litlfred/smart-trust-tools/kg/id/OI-10>
    a stt:OpenIssue ;
    dcterms:identifier "OI-10" ;
    dcterms:title "Deployed section anchors and preview paths need checking" ;
    dcterms:description "The ci and published URLs for PR 129 content, and every section anchor, are computed (see sources.yaml) and cannot be checked until the PR is merged and deployed. Re-run tools/build_kg.py --check-links after deployment." ;
