<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001>
    a stt:Requirement ;
    dcterms:identifier "STT-PAY-001" ;
    dcterms:title "Typed DVCMin model" ;
    stt:statement "The library SHALL provide a typed DVCMin payload with the short element names and cardinalities of the logical model: n 1..1, dob 1..1, s 1..1, nt 1..1, id 0..1, dt 0..1, gn 0..1, vx 1..1, v 1..1, and a PayloadCodec for it." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvcmin> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-2> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-dvcmin> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-payload-codec> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:quote "The DVC payload uses short element names because every byte is paid for twice" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvcmin> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002>
    a stt:Requirement ;
    dcterms:identifier "STT-PAY-002" ;
    dcterms:title "Typed DVCMinVaccineDetails model" ;
    stt:statement "The library SHALL provide the vx structure with vp 1..1, dv 1..1, cn 0..1, is 0..1 and bo 1..1." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvcmin-vx> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-dvcmin-vx> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:quote "Populate the logical model you selected." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvcmin-vx> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-003>
    a stt:Requirement ;
    dcterms:identifier "STT-PAY-003" ;
    dcterms:title "One immunization event per DVC" ;
    stt:statement "A DVCMin SHALL carry exactly one vx. The library SHALL provide a helper that turns one visit with N administered vaccines into N payloads, one per vaccine, and so N certificates." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-003/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-003/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-dvc-split> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:quote "vx is 1..1. One DVC documents one immunization event. A visit at which two vaccines are administered produces two certificates and two QR codes." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-004>
    a stt:Requirement ;
    dcterms:identifier "STT-PAY-004" ;
    dcterms:title "Issuer-or-clinician invariant" ;
    stt:statement "Validation SHALL fail a DVCMin whose vx has neither is nor cn (invariant must-have-issuer-or-clinician-name). The issuer SHALL NOT sign a payload that fails validation." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-004/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:quote "At least one of is or cn must be present" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-005>
    a stt:Requirement ;
    dcterms:identifier "STT-PAY-005" ;
    dcterms:title "Subjects with no identity document" ;
    stt:statement "The DVCMin model SHALL allow id and dt to be absent and SHALL support gn (parent or guardian) for subjects such as newborns." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-005/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-005/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:quote "id is optional precisely because many certificate subjects have no identification document." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-005/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-006>
    a stt:Requirement ;
    dcterms:identifier "STT-PAY-006" ;
    dcterms:title "Pluggable terminology for vp (PreQual, ICD-11)" ;
    stt:statement "vp validation SHALL go through a pluggable TerminologyValidator. A DVCMinPreQual validation profile SHALL require vp to be a WHO PreQual product identifier (required binding). The unconstrained DVCMin profile SHALL accept any code. The library SHOULD bundle the DVC - Vaccines ICD-11 codes as a default validator. It SHALL NOT bundle the PreQual database." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-006/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvcmin-prequal> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-006/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvc-vaccines-vs> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-006/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-terminology> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-006/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:quote "DVCMinPreQual binds vp to the WHO PreQual product identifiers (required binding)" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-006/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvcmin-prequal> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-006/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvc-vaccines-vs> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-007>
    a stt:Requirement ;
    dcterms:identifier "STT-PAY-007" ;
    dcterms:title "Nationality is ISO 3166-1 alpha-3" ;
    stt:statement "Validation SHALL check that nt is an ISO 3166-1 alpha-3 code, including user-assigned codes such as XXA, which is used for testing." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-007/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-007/derivation/2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-007/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> ;
    stt:quote "Nationality, ISO 3166-1 alpha-3" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-007/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-008>
    a stt:Requirement ;
    dcterms:identifier "STT-PAY-008" ;
    dcterms:title "Preserve unknown payload elements" ;
    stt:statement "Decoding a typed payload SHALL keep unknown elements and SHALL NOT fail because of them, so that newer template versions (v) can still be read and displayed." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-008/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-008/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7> ;
    stt:quote "Decoding applications SHOULD however be permissive and robust in these aspects" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-009>
    a stt:Requirement ;
    dcterms:identifier "STT-PAY-009" ;
    dcterms:title "Other payloads" ;
    stt:statement "Subclaim 5 SHALL have a typed codec holding a URI string. Subclaims 1, 3, 4 and -7 SHALL at least be issuable and verifiable as raw CBOR payloads. Typed codecs for them MAY follow." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-009/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-sd-hcert> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-009/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/ext-mtl-min> ;
