<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-006>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-006" ;
    dcterms:title "Kotlin and Rust behave the same" ;
    stt:statement "The Kotlin and Rust libraries SHALL expose the same conceptual operations, the same configuration knobs and the same failure taxonomy, with idiomatic naming in each language, and SHALL pass the same conformance vectors." ;
    stt:conformance "SHALL" ;
    stt:category "architecture" ;
    stt:derivationType "directive" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-006/derivation/1> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-004> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-005> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001> ;
    stt:verifiedBy <https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-003> .

