    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc4648> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-003/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-vhl-link> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy3-4.1.3> ;
    stt:quote "Prefixed with vhlink:/" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-003/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc4648> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-004>
    a stt:Requirement ;
    dcterms:identifier "STT-VHL-004" ;
    dcterms:title "VHL key generation" ;
    stt:statement "The library SHALL generate a VHL key as 32 bytes from the platform's cryptographically secure random generator, encoded as 43 base64url characters." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy3-4.1.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-shl> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-004/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-vhl-key> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy3-4.1.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-shl> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-005>
    a stt:Requirement ;
    dcterms:identifier "STT-VHL-005" ;
    dcterms:title "ITI-YY5 manifest request" ;
    stt:statement "The library SHALL build the ITI-YY5 Retrieve Manifest request from a VHL payload: POST to <base>/List/_search (accepting a manifest URL of either the List?... or the List/_search?... form), Content-Type application/x-www-form-urlencoded, body holding the manifest URL's search parameters (_id, code, status and patient.identifier required; _include=List:item optional) plus recipient (required), passcode (required when, and only when, the payload's flag has P) and embeddedLengthMax (optional). It SHALL refuse a payload whose URL lacks a required parameter. Sending the request is the host's." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.1.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-005/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-vhl> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-005/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-vhl-manifest-request> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-25> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-29> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-005/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.1.2> ;
    stt:quote "The VHL Receiver performs an HTTP POST to the _search endpoint with the manifest URL parameters from the VHL payload" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-005/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-vhl> ;
    stt:quote "Manifest -> go with IHE VHL" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-006>
    a stt:Requirement ;
    dcterms:identifier "STT-VHL-006" ;
    dcterms:title "ITI-YY5 manifest response" ;
    stt:statement "The library SHALL read the ITI-YY5 response, a FHIR searchset Bundle: the List with search.mode match and, when the Include DocumentReference option was used, the DocumentReferences with search.mode include. For each document it SHALL return the attachment URL and the decrypted content type (attachment.contentType); for List items whose DocumentReference is not included it SHALL return the reference for the host to read." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-006/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.2.4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-006/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-005> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-vhl-manifest> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-27> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-006/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.2.2> ;
    stt:quote "the Retrieve Manifest response is — at the FHIR level — an MHD ITI-66 response message" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-006/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.2.4> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-007>
    a stt:Requirement ;
    dcterms:identifier "STT-VHL-007" ;
    dcterms:title "Document encryption: JWE dir / A256GCM" ;
    stt:statement "Document binaries SHALL be encrypted and decrypted as JWE Compact Serialization (RFC 7516) with alg dir and enc A256GCM (RFC 7518), the VHL key as the content key and the protected header as additional authenticated data, following SMART Health Links. Decryption SHALL refuse any other alg or enc, SHALL accept zip DEF, and SHALL fail on a bad tag. Encryption SHALL set cty to the document's content type." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.2.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-007/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc7516> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-007/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc7518> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-007/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-vhl> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-007/derivation/4> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-vhl-jwe> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-24> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-007/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.2.5> ;
    stt:quote "VHL document binaries are encrypted following the SMART Health Links — Encrypting and Decrypting Files convention" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-007/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc7516> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-007/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc7518> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-007/derivation/4>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-vhl> ;
    stt:quote "Encryption as VHL" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-008>
    a stt:Requirement ;
    dcterms:identifier "STT-VHL-008" ;
    dcterms:title "Receiver authentication: HTTP Message Signatures" ;
    stt:statement "For the ITI-YY5 HTTP Message Signatures option the library SHALL compute Content-Digest (RFC 9530, sha-256, Structured Field byte sequence) and the RFC 9421 signature base over @method, @path, @authority, content-type and content-digest with created, keyid and alg parameters, return the bytes for the host to sign with the receiver's key, and assemble the Signature-Input and Signature headers from the result. For ecdsa-p256-sha256 the signature SHALL be the 64-byte r||s; a DER signature SHALL be converted." ;
    stt:conformance "SHALL" ;
    stt:category "security" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.1.3> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-008/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9421> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-008/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9530> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-008/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-vhl> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-008/derivation/4> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-005> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-vhl-http-signature> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-26> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-28> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-008/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.1.3> ;
    stt:quote "Implementations MAY authenticate using HTTP Message Signatures per RFC 9421" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-008/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9421> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-008/derivation/3>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9530> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-008/derivation/4>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-vhl> ;
    stt:quote "Trust - IHE VHL" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-009>
    a stt:Requirement ;
    dcterms:identifier "STT-VHL-009" ;
    dcterms:title "VHL expiry" ;
    stt:statement "Validating a VHL payload against a caller-supplied now SHALL report an expired link when the payload's exp has passed, in addition to the HCERT exp check made by the verifier." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/doc-ihe-vhl-yy4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-009/derivation/1> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-vhl-payload> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-009/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/doc-ihe-vhl-yy4> ;
    stt:quote "Check the payload's exp (if present) - reject if current time > expiration" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-010>
    a stt:Requirement ;
    dcterms:identifier "STT-VHL-010" ;
    dcterms:title "VHL with no I/O in the library" ;
    stt:statement "The VHL functions SHALL do no network, file or clock access: the host sends the ITI-YY5 request and the ITI-68 document GETs over mutual TLS, holds the receiver's signing key, and logs AuditEvents. The library builds, parses, signs-by-proxy and decrypts." ;
    stt:conformance "SHALL" ;
    stt:category "architecture" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.2.4> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-010/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-journeys> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-VHL-010/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-012> ;
