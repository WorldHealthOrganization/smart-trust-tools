<https://github.com/litlfred/smart-trust-tools/kg/id/OI-24>
    a stt:OpenIssue ;
    dcterms:identifier "OI-24" ;
    dcterms:title "IHE VHL leaves JWE alg/enc non-normative" ;
    dcterms:description """Document encryption names dir / A256GCM only in an example and defers to "Cryptographic Algorithm Selection", which mandates nothing for encryption (its only baseline is RS256 for signatures). Two conformant implementations need not interoperate. SMART Health Links, which the section cites, fixes dir / A256GCM.""" ;
    stt:upstreamFix true ;
    stt:resolutionHint "The library implements dir / A256GCM only and refuses anything else (STT-VHL-007)." ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.2.5> ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-1.5.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/OI-25>
    a stt:OpenIssue ;
    dcterms:identifier "OI-25" ;
    dcterms:title "Manifest URL is List? in one place and List/_search? in another" ;
    dcterms:description "ITI-YY3 builds the manifest URL as .../List/_search?...; ITI-YY5 shows .../List?... and says the receiver POSTs the parameters to _search. The library accepts both and always POSTs to <base>/List/_search (STT-VHL-005)." ;
    stt:upstreamFix true ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy3-4.1.3> ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.1.2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/OI-26>
    a stt:OpenIssue ;
    dcterms:identifier "OI-26" ;
    dcterms:title "IHE's Content-Digest example is not RFC 9530 syntax" ;
    dcterms:description """The ITI-YY5 example sends "Content-Digest: sha-256=X48E...=", but RFC 9530 makes the value a Structured Field byte sequence, "sha-256=:X48E...=:". A sharer verifying strictly rejects the example form. The library emits RFC 9530 syntax (STT-VHL-008).""" ;
    stt:upstreamFix true ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.1.3> ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9530> .

<https://github.com/litlfred/smart-trust-tools/kg/id/OI-27>
    a stt:OpenIssue ;
    dcterms:identifier "OI-27" ;
    dcterms:title "No signed manifest in IHE VHL or SMART Health Links" ;
    dcterms:description """The journeys ask to "verify DVC and signed VHL manifests against the DEV trust list". Neither specification signs the manifest: the VHL link is signed (the HCERT), and the manifest's integrity rests on mutual TLS and receiver authentication. Either the journey wording changes, or a signed-manifest option is proposed upstream.""" ;
    stt:upstreamFix true ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.2.2> ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/dir-journeys> .

<https://github.com/litlfred/smart-trust-tools/kg/id/OI-28>
    a stt:OpenIssue ;
    dcterms:identifier "OI-28" ;
    dcterms:title "How a receiver's keyid, and a DID trust list entry, map to keys" ;
    dcterms:description """ITI-YY5 says keyid is "used to locate key in trust list" but not how; and ITI-YY2's DID trust list is not tied to the COSE kid (8-byte SHA-256 of the DSC) that ITI-YY4 uses to find the VHL signer.""" ;
    stt:upstreamFix true ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy5-4.1.3> ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/doc-ihe-vhl> .

<https://github.com/litlfred/smart-trust-tools/kg/id/OI-29>
    a stt:OpenIssue ;
    dcterms:identifier "OI-29" ;
    dcterms:title "$generate-vhl sends the passcode in a GET query string" ;
    dcterms:description "ITI-YY3's $generate-vhl is a GET with passcode as a query parameter, so the passcode lands in server and proxy logs. Host concern, not the library's; noted for the policy track." ;
    stt:upstreamFix true ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/vhl-yy3-4.1.3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-001>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-001" ;
    dcterms:title "Issuance and verification of the full HCERT QR pipeline" ;
    stt:statement "The library SHALL implement issuance (steps 1 to 9) and verification (QR Code Generation section 11) of HCERT QR codes." ;
    stt:conformance "SHALL" ;
    stt:category "scope" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-001/derivation/1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-1> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-2> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-4> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-5> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-6> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-7> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-8> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-9> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-verify> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/IssuerVDHC-generate> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/IssuerVDHC-sign> ;
    stt:satisfies <https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-validate-hash> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-issuer> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-001/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-1> ;
    stt:quote "Steps 3 to 9 never vary. A verifier runs the same list upwards." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-002>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-002" ;
    dcterms:title "Every step callable on its own" ;
    stt:statement "Each pipeline step SHALL be exposed as a separate public operation (payload codec, CBOR, COSE sign/parse, ZLIB, Base45, HC1 prefix) as well as through the end-to-end issuer and verifier, so that integrators can substitute or inspect any stage." ;
    stt:conformance "SHALL" ;
    stt:category "architecture" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-1> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-intro> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-002/derivation/2> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-cbor> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-sign1> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-zlib> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-base45> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-hc1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-1> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-002/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-intro> ;
    stt:quote "The first step below is therefore a selection step, and everything after it is mechanical." .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-003>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-003" ;
    dcterms:title "Payload-agnostic core" ;
    stt:statement "The modules for steps 3 to 9 SHALL NOT depend on any payload logical model. Payloads SHALL be plugged in through a PayloadCodec registered against a subclaim." ;
    stt:conformance "SHALL" ;
    stt:category "architecture" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-intro> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-003/derivation/1> ;
    stt:refines <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-001> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-payload-codec> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-subclaim-registry> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-003/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-intro> ;
    stt:quote "The container, the signature and the transport encoding are the same for every GDHCN trust domain ... What changes from one use case to the next is only the payload" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-004>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-004" ;
    dcterms:title "Kotlin first, for JVM, Android and Node" ;
    stt:statement "The first implementation SHALL be a Kotlin Multiplatform library with all pipeline logic in common code. It SHALL ship for three targets: JVM (Java 11+), Android, and Node.js (Kotlin/JS IR, published to npm with an @JsExport facade and generated TypeScript declarations). Other KMP targets MAY follow." ;
    stt:conformance "SHALL" ;
    stt:category "non-functional" ;
    stt:derivationType "directive" ;
    stt:target "kotlin" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-004/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-004/derivation/2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-004/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-004/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-005>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-005" ;
    dcterms:title "Rust second, for WebAssembly" ;
    stt:statement "The second implementation SHALL be a Rust library meeting this same requirement set. It SHALL build for wasm32 as a WebAssembly component implementing the WIT worlds in api/wit, and SHALL be transpiled with jco into an npm package usable from Node.js and browsers. A native crate SHALL also be published. The codec module SHOULD build without std (with alloc)." ;
    stt:conformance "SHALL" ;
    stt:category "non-functional" ;
    stt:derivationType "directive" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-languages> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-005/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-targets> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-005/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-wit> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-005/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-jco> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-005/derivation/4> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-005/derivation/1>
    a stt:Derivation ;
