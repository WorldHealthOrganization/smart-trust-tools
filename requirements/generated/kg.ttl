<https://github.com/litlfred/smart-trust-tools/kg/id/OI-08>
    a stt:OpenIssue ;
    dcterms:identifier "OI-08" ;
    dcterms:title "Logical model link in hcert_spec uses a different case" ;
    dcterms:description "hcert_spec.md links StructureDefinition-hcert.html. The resource id is HCert, so the page is StructureDefinition-HCert.html, which is the link QR Code Generation 2.1 uses. On case-sensitive hosting the lowercase link breaks." ;
    stt:upstreamFix true ;
    stt:concerns <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.1> ;
