<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-012>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-012" ;
    dcterms:title "Synchronous core with no I/O" ;
    stt:statement "The pipeline core SHALL do no network or file I/O and SHALL NOT read an ambient clock. Trust material SHALL be loaded into a trust store by the host, and the current time SHALL be passed as an argument. Fetching, caching and refreshing trust lists SHALL live in separate, platform-specific modules." ;
    stt:conformance "SHALL" ;
    stt:category "architecture" ;
    stt:derivationType "derived" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-wit> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-012/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-012/derivation/2> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-trust-provider> ;
    stt:constrainsApi <https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier> ;
    stt:affectedBy <https://github.com/litlfred/smart-trust-tools/kg/id/OI-15> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-012/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/std-wit> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-012/derivation/2>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2> ;
    stt:quote "Works fully offline — Yes — verifier needs only the trust list" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-013>
    a stt:Requirement ;
    dcterms:identifier "STT-GEN-013" ;
    dcterms:title "Types and schemas trace to open standards" ;
    stt:statement "Every data type in the API contract, wire schema and payload models SHALL trace to an openly available standard: IETF CBOR/CDDL (RFC 8949, RFC 8610) for the wire format, HL7 FHIR data types and W3C XSD datatypes for payload elements, W3C JSON-LD and SHACL for payload semantics, ITU-T X.680 for certificates, and I-JSON (RFC 7493) for JSON files. Paywalled standards SHALL NOT be used as type or schema references." ;
    stt:conformance "SHALL" ;
    stt:category "architecture" ;
    stt:derivationType "directive" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/dir-open-standards> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-013/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8610> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-013/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-fhir-datatypes> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-013/derivation/3> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-xsd2> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-013/derivation/4> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-json-ld> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-013/derivation/5> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-shacl> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-013/derivation/6> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-x680> ;
