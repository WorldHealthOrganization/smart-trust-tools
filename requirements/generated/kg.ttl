<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-002>
    a stt:Requirement ;
    dcterms:identifier "STT-CWT-002" ;
    dcterms:title "NumericDate integers" ;
    stt:statement "iat and exp SHALL be encoded as integer NumericDate (seconds since the epoch). The decoder SHOULD accept floating-point NumericDate and truncate it." ;
    stt:conformance "SHALL" ;
    stt:category "functional" ;
    stt:derivationType "direct" ;
    stt:target "kotlin" ;
    stt:target "rust" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.5> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-002/derivation/1> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.6> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-002/derivation/2> ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8392> ;
    stt:hasDerivation <https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-002/derivation/3> ;
    stt:implementsStep <https://github.com/litlfred/smart-trust-tools/kg/id/step-3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-002/derivation/1>
    a stt:Derivation ;
    stt:source <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.5> ;
    stt:quote "SHALL hold a timestamp in the integer NumericDate format" .

<https://github.com/litlfred/smart-trust-tools/kg/id/STT-CWT-002/derivation/2>
    a stt:Derivation ;
