<https://github.com/litlfred/smart-trust-tools/kg/id/step-1>
    a stt:PipelineStep ;
    dcterms:title "Select payload type" ;
    stt:order 1 ;
    stt:output "hcert subclaim + logical model" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-2> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-2>
    a stt:PipelineStep ;
    dcterms:title "Assemble payload" ;
    stt:order 2 ;
    stt:output "logical-model instance" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-3> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-3>
    a stt:PipelineStep ;
    dcterms:title "Wrap in CWT claim set" ;
    stt:order 3 ;
    stt:output "{1: iss, 6: iat, 4: exp, -260: {subclaim: payload}}" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-4> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-4>
    a stt:PipelineStep ;
    dcterms:title "Serialise as CBOR" ;
    stt:order 4 ;
    stt:output "bytes" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-5> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-5>
    a stt:PipelineStep ;
    dcterms:title "Sign as COSE_Sign1" ;
    stt:order 5 ;
    stt:output "bytes, CBOR tag 18" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-6> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-6>
    a stt:PipelineStep ;
    dcterms:title "Compress with ZLIB/Deflate" ;
    stt:order 6 ;
    stt:output "bytes" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-7> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-7>
    a stt:PipelineStep ;
    dcterms:title "Encode as Base45" ;
    stt:order 7 ;
    stt:output "ASCII" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-8> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-8>
    a stt:PipelineStep ;
    dcterms:title "Prefix context identifier HC1:" ;
    stt:order 8 ;
    stt:output "ASCII" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-9> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-9>
    a stt:PipelineStep ;
    dcterms:title "Render QR (Alphanumeric, EC Q)" ;
    stt:order 9 ;
    stt:output "QR symbol" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-10> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-verify>
    a stt:PipelineStep ;
    dcterms:title "Verify (steps 9 to 1 in reverse, plus trust list lookup)" ;
    stt:order 10 ;
    stt:output "verified payload or typed failure" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/qr-11> .

<https://github.com/litlfred/smart-trust-tools/kg/id/step-trust>
    a stt:PipelineStep ;
    dcterms:title "Obtain trusted DSCs" ;
    stt:order 11 ;
    stt:output "candidate DSCs for a kid" ;
    prov:wasDerivedFrom <https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A> .

