      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-003",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-KID-003",
      "dcterms:title": "kid text forms",
      "stt:statement": "Kid SHALL convert to and from hex, standard base64 and URL-safe base64. Trust-list matching SHALL compare the kid bytes, not their text form.",
      "stt:conformance": "SHALL",
      "stt:category": "api",
