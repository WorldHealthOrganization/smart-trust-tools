    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-PAY-001",
      "dcterms:title": "Typed DVCMin model",
      "stt:statement": "The library SHALL provide a typed DVCMin payload with the short element names and cardinalities of the logical model: n 1..1, dob 1..1, s 1..1, nt 1..1, id 0..1, dt 0..1, gn 0..1, vx 1..1, v 1..1, and a PayloadCodec for it.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvcmin"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-2"
      },
      "stt:constrainsApi": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-dvcmin"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-payload-codec"
        }
      ],
      "stt:verifiedBy": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
      },
      "stt:quote": "The DVC payload uses short element names because every byte is paid for twice"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvcmin"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-PAY-002",
      "dcterms:title": "Typed DVCMinVaccineDetails model",
      "stt:statement": "The library SHALL provide the vx structure with vp 1..1, dv 1..1, cn 0..1, is 0..1 and bo 1..1.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/ext-dvcmin-vx"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-2"
      },
      "stt:refines": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001"
      },
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-dvcmin-vx"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
      },
      "stt:quote": "Populate the logical model you selected."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
