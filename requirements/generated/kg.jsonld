    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-TST-001",
      "dcterms:title": "PR 129 example as a conformance vector",
      "stt:statement": "Both libraries SHALL verify the two HC1 strings in dvc-qr-example-XXA.json against dvc-qr-example-XXA-dsc.pem, with the clock fixed inside 2026-09-29T08:30Z to 2027-09-29T08:30Z. Each SHALL give kid WHM+BYqqZiE=, subclaim -6, and payloads equal to those in the JSON. The committed files SHALL be used as-is; they SHALL NOT be regenerated.",
      "stt:conformance": "SHALL",
      "stt:category": "test",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.6"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-json"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/doc-qr-example-pem"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/2"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/3"
        }
      ],
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-testkit"
      },
      "stt:affectedBy": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/OI-01"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.6"
      },
      "stt:quote": "so that a verifier implementation can be exercised against this example end to end"
    },
    {
