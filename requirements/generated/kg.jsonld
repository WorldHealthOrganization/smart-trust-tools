        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-ZIP-001/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-6"
      },
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-zlib"
      }
