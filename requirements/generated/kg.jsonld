    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-SEL-004",
      "dcterms:title": "Exactly one payload when issuing",
      "stt:statement": "The issuer SHALL emit an hcert (-260) map with exactly one entry. The verifier SHALL fail verification with MultipleSubclaims when there is more than one entry, and with HcertMissing when there is none.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-2"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-4"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/2"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/3"
        }
      ],
      "stt:implementsStep": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-3"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
        }
      ],
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-hcert-claim"
      },
      "stt:affectedBy": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/OI-02"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-2"
      },
      "stt:quote": "An HCERT carries exactly one payload, identified by a subclaim inside the hcert claim"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-4"
      },
      "stt:quote": "Map whose single key is the subclaim chosen in Step 1"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-004/derivation/3",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7"
      },
      "stt:quote": "Several different types of health certificate MAY exist under the same claim"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-006",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-SEL-006",
      "dcterms:title": "Trust domain codes come from the value set",
      "stt:statement": "Trust domain codes (currently DDCC, IPS-PILGRIMAGE, PH4H, ICVP) SHALL be treated as data loaded from, or checked against, the GDHCN Trust Domain value set. They SHALL NOT be a closed enum.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
