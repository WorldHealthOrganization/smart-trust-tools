        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
      },
      "stt:quote": "Read the hcert claim, dispatch on the subclaim to the right logical model, and only then apply business rules."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-008",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-VER-008",
      "dcterms:title": "Typed verification result and failure taxonomy",
      "stt:statement": "A certificate failing verification SHALL produce a Failed result, not an exception or panic. Failed results SHALL name the step that failed and a reason from a closed set shared by both languages: BadPrefix, UnsupportedContextVersion, Base45Invalid, InflateFailed, LimitExceeded, CoseMalformed, HeaderInvalid, UnsupportedAlgorithm, KidNotFound, SignatureInvalid, KeyUsageMismatch, Expired, NotYetValid, HcertMissing, MultipleSubclaims, PayloadInvalid. Exceptions or errors SHALL be reserved for programming errors and infrastructure failures.",
      "stt:conformance": "SHALL",
      "stt:category": "api",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
