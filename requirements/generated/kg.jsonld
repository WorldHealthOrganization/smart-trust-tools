        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier"
        }
      ]
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-009/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.1"
      },
      "stt:quote": "the HCERT container and its payloads may be transferred as-is, utilising any underlying, 8 bit safe, reliable data transport"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-010",
      "@type": "stt:Requirement",
