      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7.1"
      },
      "stt:quote": "While the logical model enlists assigned sub claims, the ones listed in this specification are considered authoritative"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-001/derivation/3",
      "@type": "stt:Derivation",
      "stt:source": {
