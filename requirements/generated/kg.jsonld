        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002/derivation/2"
        }
      ],
      "stt:implementsStep": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-trust"
        }
      ],
      "stt:constrainsApi": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-trust-provider"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier"
        }
      ],
      "stt:verifiedBy": {
