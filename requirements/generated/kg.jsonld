    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TRU-001",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-TRU-001",
      "dcterms:title": "Trust store",
      "stt:statement": "Trust material SHALL be held in a trust store that the host fills with DSCs it has obtained, and that returns every trusted DSC matching a kid. The store SHALL do no network or file I/O (STT-GEN-012).",
      "stt:conformance": "SHALL",
      "stt:category": "api",
