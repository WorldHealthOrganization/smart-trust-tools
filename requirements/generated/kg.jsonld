    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-SEC-001",
      "dcterms:title": "No payload content in logs",
      "stt:statement": "The libraries SHALL NOT log payload content, HC1 strings or decoded claims at any default log level. A QR code holds readable personal data.",
      "stt:conformance": "SHALL NOT",
      "stt:category": "security",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.1"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/2"
        }
      ]
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.2"
      },
      "stt:quote": "All data is in the QR and is readable by anyone who scans it"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEC-001/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
