    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-011",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-VER-011",
      "dcterms:title": "Unverified read for triage",
      "stt:statement": "The verifier SHALL offer an explicitly named unverified read (read-unverified) that decodes an HC1 string up to and including the payload without any trust lookup or signature check, for display and triage where verification is not possible, such as a community health worker offline at a household (journey J2). Its result type SHALL be distinct from a verified result, SHALL carry the kid and the claims it found, and SHALL state that nothing in it is verified. It SHALL apply the same decode limits as verify.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "directive",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/dir-journeys"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-011/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-011/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
      },
      "stt:refines": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002"
      },
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-unverified"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-011/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/dir-journeys"
      },
      "stt:quote": "lightweight QR scan reads basic vaccine metadata without requiring full cryptographic verification at the household edge"
    },
