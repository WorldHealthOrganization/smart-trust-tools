        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.3"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-COS-004",
      "dcterms:title": "Sig_structure",
      "stt:statement": "The signature input SHALL be the CBOR encoding of [\"Signature1\", protected header bytes exactly as transmitted, empty external_aad, payload bytes]. The verifier SHALL use the received protected bytes and SHALL NOT re-encode the decoded header.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-6"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8152"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/2"
        }
      ],
      "stt:implementsStep": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-5"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
        }
      ],
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-sign1"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-6"
      },
      "stt:quote": "serialise it as CBOR, and sign those bytes."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-004/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc8152"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-005",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-COS-005",
      "dcterms:title": "Fixed-width r||s ECDSA signatures",
      "stt:statement": "ES256 signatures SHALL be carried as 64-byte r||s. The library SHALL convert from and to the ASN.1 DER form returned or expected by platform crypto APIs (JCA, Android Keystore, PKCS#11, RustCrypto). The verifier SHALL reject an ES256 signature that is not exactly 64 bytes.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-6"
      },
      "stt:hasDerivation": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-005/derivation/1"
      },
      "stt:implementsStep": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-5"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
        }
      ],
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-ecdsa-format"
      },
      "stt:verifiedBy": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-005/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-6"
      },
      "stt:quote": "For ES256 the COSE signature value is the fixed-width concatenation r || s, 32 bytes each — not the ASN.1 DER encoding"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-COS-006",
      "dcterms:title": "No private keys required in-process",
      "stt:statement": "The issuer SHALL NOT need access to private key material: issuance is prepare, then the caller signs the returned bytes by any means (HSM, KMS, PKCS#11, Android Keystore, WebCrypto), then finish (STT-ISS-004). A software ES256 and PS256 signer SHALL be provided for tests only, in the testkit module.",
      "stt:conformance": "SHALL",
      "stt:category": "security",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-13"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-5"
      },
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-pending-signature"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.2"
      },
      "stt:quote": "Use of HSMs for signing health certificates is highly encouraged."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-COS-006/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-13"
      },
      "stt:quote": "a real issuer holds its private keys in an HSM"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-KID-001",
      "dcterms:title": "kid derivation",
      "stt:statement": "kid SHALL be the first 8 bytes of SHA-256 over the DER-encoded DSC. The issuer SHALL derive it from the Signer's DSC, not take it from the caller.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-6"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A.1"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/2"
        }
      ],
      "stt:implementsStep": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-5"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-trust"
        }
      ],
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-kid"
      },
      "stt:verifiedBy": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-001"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-6"
      },
      "stt:quote": "take the DER encoding of the DSC and use the first 8 bytes of its SHA-256 fingerprint"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-001/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
