        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-006/derivation/3"
        }
      ],
      "stt:implementsStep": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-trust"
        }
      ]
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-006/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.1"
