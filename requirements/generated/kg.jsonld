      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-003",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-PAY-003",
      "dcterms:title": "One immunization event per DVC",
      "stt:statement": "A DVCMin SHALL carry exactly one vx. The library SHALL provide a helper that turns one visit with N administered vaccines into N payloads, one per vaccine, and so N certificates.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-003/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-003/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-2"
      },
      "stt:refines": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-003/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
      },
      "stt:quote": "vx is 1..1. One DVC documents one immunization event. A visit at which two vaccines are administered produces two certificates and two QR codes."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-003/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-004",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-PAY-004",
      "dcterms:title": "Issuer-or-clinician invariant",
      "stt:statement": "Validation SHALL fail a DVCMin whose vx has neither is nor cn (invariant must-have-issuer-or-clinician-name). The issuer SHALL NOT sign a payload that fails validation.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
      },
      "stt:hasDerivation": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-004/derivation/1"
      },
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-2"
      },
      "stt:refines": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-002"
      },
      "stt:verifiedBy": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-004/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
      },
      "stt:quote": "At least one of is or cn must be present"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-005",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-PAY-005",
      "dcterms:title": "Subjects with no identity document",
      "stt:statement": "The DVCMin model SHALL allow id and dt to be absent and SHALL support gn (parent or guardian) for subjects such as newborns.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-005/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-005/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-2"
      },
      "stt:refines": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-001"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-005/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
      },
      "stt:quote": "id is optional precisely because many certificate subjects have no identification document."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-005/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.1"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-007",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-PAY-007",
      "dcterms:title": "Nationality is ISO 3166-1 alpha-3",
      "stt:statement": "Validation SHALL check that nt is an ISO 3166-1 alpha-3 code, including user-assigned codes such as XXA, which is used for testing.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-12.3"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-007/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-PAY-007/derivation/2"
        }
