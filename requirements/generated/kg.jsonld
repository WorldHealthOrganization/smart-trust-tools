      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-KID-002/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-6"
      },
      "stt:quote": "a verifier that finds several DSCs with the same kid MUST try all of them"
    },
