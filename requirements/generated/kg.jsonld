        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-hc1"
        }
      ]
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-002/derivation/1",
