        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/std-rfc9285"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-B45-002/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-HC1-001",
      "dcterms:title": "HC1 prefix",
      "stt:statement": "The issuer SHALL prefix the Base45 string with \"HC1:\". The verifier SHALL require a context identifier matching HC[1-9A-Z]: and strip it. It SHALL report any identifier other than HC1 as an unsupported version, distinct from malformed input.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-9"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/2"
        }
      ],
      "stt:implementsStep": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-8"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
        }
      ],
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-hc1"
      },
      "stt:verifiedBy": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-9"
      },
      "stt:quote": "A future backwards-incompatible revision will use a new identifier, incrementing through [1-9] and then [A-Z]."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-HC1-001/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-QR-001",
      "dcterms:title": "QR-ready HC1 output; no QR encoding in the library",
      "stt:statement": "The HC1 string SHALL consist only of characters in the QR Alphanumeric set (the Base45 alphabet and the \"HC1:\" prefix), so that integrators can encode it as a single Alphanumeric-mode segment with error correction Q using any QR encoder. The libraries SHALL NOT encode or render QR symbols.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-10"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/std-iso18004"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/2"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/3"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-9"
      },
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-hc1"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-10"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-4.2.2"
      },
      "stt:quote": "The Alphanumeric (Mode 2/QR Code symbols 0010) MUST be used in conjunction with Base45."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-001/derivation/3",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/std-iso18004"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-005",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-QR-005",
      "dcterms:title": "Camera scanning out of scope",
      "stt:statement": "Decoding QR images from a camera or file is out of scope for the core libraries. The verifier entry point SHALL be the scanned text (HC1 string) or raw COSE bytes.",
      "stt:conformance": "SHALL",
      "stt:category": "scope",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
      },
      "stt:hasDerivation": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-005/derivation/1"
      },
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
      },
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-QR-005/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
      },
      "stt:quote": "Confirm the HC1: prefix and strip it."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-VER-001",
      "dcterms:title": "Verification order",
      "stt:statement": "The verifier SHALL run the QR Code Generation section 11 sequence in order: prefix, Base45, inflate, COSE parse, header validation, trust lookup by kid, signature verification, EKU check, CWT decode and time checks, subclaim dispatch, business rules.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
      },
      "stt:satisfies": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-reveive"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/UtilizeVDHC-validate-hash"
        }
      ],
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-1"
      },
      "stt:quote": "A verifier runs the same list upwards."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-VER-002",
      "dcterms:title": "No payload access before the signature is verified",
      "stt:statement": "The API SHALL make the payload and claims reachable only through a successful verification result type. Code that inspects an unverified payload SHALL go through an explicitly named unsafe or diagnostic call.",
      "stt:conformance": "SHALL",
      "stt:category": "security",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
      },
      "stt:refines": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001"
      },
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-result"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
      },
      "stt:quote": "Verify the signature before processing the payload."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-002/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3"
      },
      "stt:quote": "The Issuer Signature SHALL also be verified before any processing of the contents of the HCERT takes place."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-VER-003",
      "dcterms:title": "Defensive protected-header parsing",
      "stt:statement": "Before the signature is checked, the verifier SHALL validate the types and lengths in the protected header: alg is a supported integer, kid is a byte string of the expected length, and no duplicate labels. It SHALL fail closed on anything unexpected.",
      "stt:conformance": "SHALL",
      "stt:category": "security",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
      },
      "stt:refines": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-001"
      },
      "stt:verifiedBy": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006"
        }
      ]
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
      },
      "stt:quote": "Parsing the protected header necessarily happens before signature verification, which makes it an attack surface"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-003/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-VER-004",
      "dcterms:title": "EKU check against certificate type",
      "stt:statement": "If the matching DSC has an Extended Key Usage extension with any of 1.3.6.1.4.1.1847.2021.1.1 (test), .1.2 (vaccinations) or .1.3 (recovery), the verifier SHALL check it against the certificate type of the payload: DVC (-6) and DDCC VS (3) are vaccinations, DDCC TR (4) is test, and a DCC (1) is the type of its single v, t or r entry. A DSC with no such extension SHALL be accepted for any type.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A.2"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
      },
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier"
      },
      "stt:verifiedBy": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004"
      },
      "stt:affectedBy": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/OI-03"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-004/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-A.2"
      },
      "stt:quote": "If one or more are present, the verifiers SHALL verify the key usage against the stored HCERT."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-VER-005",
      "dcterms:title": "Time checks with an injected clock",
      "stt:statement": "The verifier SHALL reject a certificate whose exp is in the past, and one whose iat is in the future beyond a configurable clock-skew tolerance. The current time SHALL be passed in by the caller (now), never read from an ambient clock.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.5"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.6"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/2"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/3"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
      },
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-verifier"
      },
      "stt:verifiedBy": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-004"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
      },
      "stt:quote": "Decode the CBOR payload and check exp and iat against the current time."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.5"
      },
      "stt:quote": "after which a Verifier MUST reject the Payload as expired"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-005/derivation/3",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.6"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-006",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-VER-006",
      "dcterms:title": "Trust-list presence is the DSC validity check",
      "stt:statement": "The verifier SHALL NOT need CRL or OCSP access. A DSC is valid if it is on the current trust list. The verifier SHOULD also check the DSC's X.509 validity period against the injected clock.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-5.1"
      },
      "stt:hasDerivation": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-006/derivation/1"
      },
      "stt:implementsStep": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-trust"
        }
      ]
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-006/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-5.1"
      },
      "stt:quote": "the primary validity mechanism is the presence of the certificate on the most recent version of that certificate list."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-VER-007",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-VER-007",
      "dcterms:title": "Dispatch to logical model, then business rules",
      "stt:statement": "After verification the verifier SHALL decode the hcert entry with the codec registered for its subclaim, falling back to RawPayload. It SHALL then run any registered BusinessRuleHooks and attach their outcomes to the result.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
      },
      "stt:hasDerivation": {
