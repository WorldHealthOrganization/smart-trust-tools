    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-1",
      "@type": "stt:PipelineStep",
      "dcterms:title": "Select payload type",
      "stt:order": 1,
      "stt:output": "hcert subclaim + logical model",
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-2"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-2",
      "@type": "stt:PipelineStep",
      "dcterms:title": "Assemble payload",
      "stt:order": 2,
      "stt:output": "logical-model instance",
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-3"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-3",
      "@type": "stt:PipelineStep",
      "dcterms:title": "Wrap in CWT claim set",
      "stt:order": 3,
      "stt:output": "{1: iss, 6: iat, 4: exp, -260: {subclaim: payload}}",
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-4"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-4",
      "@type": "stt:PipelineStep",
      "dcterms:title": "Serialise as CBOR",
      "stt:order": 4,
      "stt:output": "bytes",
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-5"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-5",
      "@type": "stt:PipelineStep",
      "dcterms:title": "Sign as COSE_Sign1",
      "stt:order": 5,
      "stt:output": "bytes, CBOR tag 18",
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-6"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-6",
      "@type": "stt:PipelineStep",
      "dcterms:title": "Compress with ZLIB/Deflate",
      "stt:order": 6,
      "stt:output": "bytes",
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-7"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-7",
      "@type": "stt:PipelineStep",
      "dcterms:title": "Encode as Base45",
      "stt:order": 7,
      "stt:output": "ASCII",
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-8"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-8",
      "@type": "stt:PipelineStep",
      "dcterms:title": "Prefix context identifier HC1:",
      "stt:order": 8,
      "stt:output": "ASCII",
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-9"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-9",
      "@type": "stt:PipelineStep",
      "dcterms:title": "Render QR (Alphanumeric, EC Q)",
      "stt:order": 9,
      "stt:output": "QR symbol",
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-10"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-verify",
      "@type": "stt:PipelineStep",
      "dcterms:title": "Verify (steps 9 to 1 in reverse, plus trust list lookup)",
      "stt:order": 10,
      "stt:output": "verified payload or typed failure",
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-11"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-trust",
