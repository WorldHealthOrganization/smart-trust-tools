        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-002/derivation/1"
      },
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-1"
      },
      "stt:refines": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-001"
      },
      "stt:constrainsApi": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-subclaim-registry"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-002/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7.1"
      },
      "stt:quote": "subclaims for negative integer values are for development purposes and are free to use"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-003",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-SEL-003",
      "dcterms:title": "Development-range subclaims need explicit opt-in",
      "stt:statement": "The registry SHALL classify subclaims >= 0 as WHO-reserved and negative subclaims as development range. The issuer SHALL refuse to issue a development-range subclaim unless the issuer policy explicitly allows it. The subclaim number used for a payload type SHALL be configuration, not a constant in a codec, so that DVC can move from -6 to an assigned number without an API break.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-3.2.7.1"
        }
      ],
      "stt:hasDerivation": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-003/derivation/1"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-003/derivation/2"
        }
      ],
      "stt:implementsStep": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/step-1"
      },
      "stt:constrainsApi": [
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-subclaim-registry"
        },
        {
          "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/api-issuer"
        }
      ],
      "stt:affectedBy": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/OI-09"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-003/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/qr-2.1"
      },
      "stt:quote": "Do not treat a negative subclaim as a production allocation."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-SEL-003/derivation/2",
      "@type": "stt:Derivation",
      "stt:source": {
