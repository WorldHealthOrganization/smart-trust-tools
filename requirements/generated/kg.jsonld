    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-TST-006",
      "dcterms:title": "Fuzzing of decoders",
      "stt:statement": "The Base45, ZLIB, CBOR, COSE and full verifier entry points SHALL be fuzzed in CI (cargo-fuzz for Rust, Jazzer or kotlinx-fuzz for Kotlin). No input may crash them, hang them, or exceed DecodeLimits.",
      "stt:conformance": "SHALL",
      "stt:category": "test",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3"
      },
      "stt:hasDerivation": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006/derivation/1"
      }
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-006/derivation/1",
      "@type": "stt:Derivation",
      "stt:source": {
        "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/hcert-6.3"
      },
      "stt:quote": "a potential attacker may attempt to inject carefully crafted information designed to compromise the security of the system"
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-TST-007",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-TST-007",
      "dcterms:title": "One TypeScript conformance suite for both Node packages",
      "stt:statement": "A single TypeScript test suite, type-checked against api/generated/ts and driven by the shared vectors, SHALL run in CI against both the Kotlin/JS npm package and the jco-transpiled Rust component, and SHALL pass on both.",
      "stt:conformance": "SHALL",
      "stt:category": "test",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
