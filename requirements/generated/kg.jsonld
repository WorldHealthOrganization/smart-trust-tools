      "stt:quote": "Steps 3 to 9 never vary. A verifier runs the same list upwards."
    },
    {
      "@id": "https://github.com/litlfred/smart-trust-tools/kg/id/STT-GEN-002",
      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-GEN-002",
      "dcterms:title": "Every step callable on its own",
      "stt:statement": "Each pipeline step SHALL be exposed as a separate public operation (payload codec, CBOR, COSE sign/parse, ZLIB, Base45, HC1 prefix) as well as through the end-to-end issuer and verifier, so that integrators can substitute or inspect any stage.",
      "stt:conformance": "SHALL",
      "stt:category": "architecture",
      "stt:derivationType": "derived",
      "stt:target": [
        "kotlin",
        "rust"
      ],
      "prov:wasDerivedFrom": [
