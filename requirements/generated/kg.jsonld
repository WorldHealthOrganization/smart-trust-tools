      "@type": "stt:Requirement",
      "dcterms:identifier": "STT-SEL-001",
      "dcterms:title": "Built-in subclaim registry",
      "stt:statement": "The library SHALL ship a subclaim registry containing 1 (HCertDCC), 3 (DDCCCoreDataSetVS), 4 (DDCCCoreDataSetTR), 5 (VHL URI), -6 (DVCMin) and -7 (MedicationTreatmentLineMin), each with its status (Assigned, Proposed, Development range) and logical-model canonical URL.",
      "stt:conformance": "SHALL",
      "stt:category": "functional",
      "stt:derivationType": "direct",
      "stt:target": [
        "kotlin",
